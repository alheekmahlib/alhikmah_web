s/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/1kmzfrn9ymvcu.js\",\"/_next/static/chunks/3qssvey5t78f1.js\",\"/_next/static/chunks/25lxdbndxci5v.js\",\"/_next/static/chunks/1ijqylqiu6wig.js\",\"/_next/static/chunks/148au1qyf5nn-.js\"],\"default\"]\ne:I[37457,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\"],\"default\"]\nf:I[92370,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/1kmzfrn9ymvcu.js\",\"/_next/static/chunks/3qssvey5t78f1.js\",\"/_next/static/chunks/25lxdbndxci5v.js\",\"/_next/static/chunks/1ijqylqiu6wig.js\",\"/_next/static/chunks/23l0dfuxbi9-u.js\"],\"default\"]\n10:I[76910,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/1kmzfrn9ymvcu.js\",\"/_next/static/chunks/3qssvey5t78f1.js\",\"/_next/static/chunks/25lxdbndxci5v.js\",\"/_next/static/chunks/1ijqylqiu6wig.js\"],\"SiteFooter\"]\n3:T40c,◉ Ang application na ito ay nagbibigay sa iyo ng kakayahang i-save ang inyong mga paboritong athkar sa isang espesyal na listahan, na ginagawa silang madaling ma-access at ma-review anumang oras.\n◉ Maaari mong kontrolin ang laki ng font at palakihin o paliitin ito ayon sa inyong preference para sa mas komportableng pagbabasa.\n◉ Ang application ay nag-aalok din ng tatlong modes para sa user interface - luntian, asul, at madilim - na nagbibigay sa iyo ng kakayahang i-customize ang hitsura ng app ayon sa inyong mga kagustuhan.\n◉ Ang nagpapangilin sa \"Mga Athkar Ko mula sa Libro at Sunnah\" ay ang kakayahang madaling magbahagi ng mga athkar sa mga kaibigan at pamilya.\n◉ Maaari kang magbahagi nang direkta sa text o sa pamamagitan ng pagpapadala ng larawan na naglalaman ng zikr, na ginagawang mas mayaman at malalim ang karanasan ng komunikasyon at pakikipag-ugnayan sa iba.\n◉ Maaari mong tukuyin ang mga oras na mas gusto mong basahin ang mga athkar, at papaalalahanin ka ng application sa mga oras na iyon nang tumpak.4:T5f2,◉ Ang application na ito ay nagbibigay-daan sa iyo na basahin ang Quran na parang binabasa mo sa Mushaf, at maaari mong basahin sa vertical at horizontal mode.\n◉ Maaari ka ring magbasa sa variable mode na nagbibigay-daan sa iyo na mag-zoom in at zoom out ayon sa inyong gusto.\n◉ Ang application ay may feature ng text search sa mga verses ng Quran sa pamamagitan ng instant search at pagpapakita ng mga resulta kasama ang mga pahina at ang posibilidad na pumunta sa pahina.\n◉ Pagdadagdag ng mga bookmark para sa pagbabasa upang makapag-save ang reader ng pahina at makabalik dito kahit kailan niya gusto.\n◉ Pagdadagdag ng mga notes.\n◉ Pakikinig sa bawat verse sa boses ng iba't ibang mga Qari.\n◉ Ang app ay nagbibigay ng tafsir para sa bawat verse, maaari mong baguhin ang pagitan ng mga tafsir at maaari mong baguhin ang laki ng font ng tafsir.\n◉ Index ng mga Surah.\n◉ Madaling pag-navigate sa pagitan ng mga Surah.\n◉ Ang app ay nagbibigay-daan sa iyo na basahin ang mga stop signs.\n◉ Ang application ay nagbibigay-daan sa iyo na basahin ang Hisnul Muslim nang buo at nahahati ayon sa mga athkar upang madaling mag-navigate ang reader sa pagitan ng mga seksyon, at maaari mong idagdag ang anumang zikr sa mga paborito.\n◉ Ang application ay nagbibigay-daan sa reader na magbasa ng pagbabago ng mga pattern ng kulay kasama ang dark pattern na nagbabago ng kulay ng background sa itim at mga puting linya upang bigyan ang reader ng kumpletong kaginhawahan kapag nagbabasa sa low-light na kapaligiran.0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/1kmzfrn9ymvcu.js\",\"async\":true}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/3qssvey5t78f1.js\",\"async\":true}],[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/chunks/25lxdbndxci5v.js\",\"async\":true}],[\"$\",\"script\",\"script-3\",{\"src\":\"/_next/static/chunks/1ijqylqiu6wig.js\",\"async\":true}]],[\"$\",\"$L2\",null,{\"locale\":\"tl\",\"messages\":{\"about\":\"About\",\"about_app\":\"Tungkol sa App\",\"about_app2\":\"Mga pinakamahalagang katangian ng program:\",\"about_body\":\"Kami ay isang library na dalubhasa sa pag-develop at paggawa ng applications na may Islamic at educational na karakter. Layunin namin na magbigay ng maaasahang at madaling gamitin na digital solutions na tumutulong sa mga Muslim na magbasa, matuto, at manatiling committed sa pag-alala sa Allah sa pamamagitan ng mga magagandang at refined na technical experiences. Nakatuon kami sa mataas na performance, accessibility, at multi-platform support upang masiguro na maabot ang mga benepisyo sa pinakamaraming users.\",\"about_contact_cta\":\"Natutuwa kaming marinig kayo — sulat sa amin sa ibaba:\",\"about_eyebrow\":\"About Us\",\"about_hadith_ref\":\"Narrated by Muslim\",\"about_hadith_text\":\"“Whoever follows a path seeking knowledge, Allah will make easy for him a path to Paradise”\",\"about_head\":\"Al Heekmah Library\",\"about_p1\":\"Alheekmah Library is a comprehensive Islamic platform, born from a passion to serve the Book of Allah and the Sunnah of His Prophet ﷺ. We believe that beneficial knowledge is a trust that must reach every home through the easiest and most beautiful means.\",\"about_p2\":\"We combine the authenticity of content with the beauty of experience, to bring you the Quran with its recitations, Adhkar, and selected books — in one harmonious interface.\",\"about_page_eyebrow\":\"About Us\",\"about_page_lede\":\"A comprehensive Islamic platform for spreading beneficial knowledge.\",\"about_page_story_1\":\"Alheekmah Library was born from a passion to serve the Book of Allah and the Sunnah of His Prophet ﷺ. We believe beneficial knowledge is a trust that must reach every home through the easiest and most beautiful means.\",\"about_page_story_2\":\"We combine content authenticity with experience beauty, to bring you the Quran with its recitations, Adhkar, and selected books — in one harmonious interface.\",\"about_page_story_3\":\"We focus on high performance, accessibility, and multi-platform support to ensure the benefit reaches the maximum number of users.\",\"about_page_title\":\"Alheekmah Library\",\"about_stat_1\":\"Downloads\",\"about_stat_2\":\"Languages\",\"about_stat_3\":\"Apps\",\"about_stat_4\":\"Free\",\"about_title\":\"Sino Kami\",\"about_title_1\":\"A message of\",\"about_title_2\":\"beneficial knowledge\",\"about_us\":\"Tungkol sa App\",\"about_value_1_desc\":\"We care about the finest details to deliver a refined experience.\",\"about_value_1_title\":\"Quality\",\"about_value_2_desc\":\"Trusted content from approved sources and reliable scholars.\",\"about_value_2_title\":\"Authenticity\",\"about_value_3_desc\":\"We put user needs first in everything we design.\",\"about_value_3_title\":\"Service\",\"about_value_4_desc\":\"Open to developers via API and open-source libraries.\",\"about_value_4_title\":\"Openness\",\"about_values_title\":\"Our Values\",\"about_vision_text\":\"To be the leading Islamic platform, in Arabic and internationally, in spreading beneficial knowledge through refined user experience and trusted content.\",\"about_vision_title\":\"Our Vision\",\"aboutAzkaryApp3\":\"$3\",\"aboutBook\":\"Tungkol sa Libro\",\"aboutBooks\":\"Tungkol sa Libro\",\"aboutQuranApp3\":\"$4\",\"aboutSurah\":\"Tungkol sa Surah\",\"action_browse\":\"Browse\",\"action_listen\":\"Listen\",\"action_read\":\"Read\",\"action_review\":\"Review\",\"allBooks\":\"Lahat ng mga Libro\",\"app_hisn_desc\":\"Adhkar and supplications from the Quran and Sunnah, in a practical daily format that helps you persist.\",\"app_hisn_title\":\"Hisnul Muslim\",\"app_not_found\":\"Hindi nahanap ang hiniling na app.\",\"app_qalaid_desc\":\"A digital library of selected Islamic books and beneficial knowledge, at your fingertips anytime.\",\"app_qalaid_title\":\"Al-Qalaid\",\"app_quran_desc\":\"A comprehensive app for reading the Holy Quran with recitations, tafsir, and translation for every verse.\",\"app_quran_title\":\"Holy Quran\",\"appGallery\":\"I-download mula sa |App Gallery|\",\"appLang\":\"Wika ng App\",\"appName\":\"Al Heekmah Library\",\"apps\":\"Our Apps\",\"apps_error\":\"Failed to load apps. Try again later.\",\"apps_eyebrow\":\"Our Apps\",\"apps_lede\":\"Apps carefully designed to accompany your daily life and be your companion on the path to Allah.\",\"apps_loading\":\"Loading apps...\",\"apps_page_eyebrow\":\"Our Apps\",\"apps_page_lede\":\"Islamic apps carefully designed to accompany your daily life.\",\"apps_page_title\":\"Apps Family\",\"apps_title_1\":\"From the\",\"apps_title_2\":\"Alheekmah\",\"apps_view_details\":\"View details\",\"appStoreD\":\"I-download mula sa |App Store| para sa Desktop\",\"appStoreI\":\"I-download mula sa |App Store|\",\"athkar\":\"Athkar\",\"athkar_copied\":\"Copied\",\"athkar_copy\":\"Copy\",\"athkar_count_label\":\"Repeat\",\"athkar_done\":\"Done, alhamdulillah\",\"athkar_empty\":\"No adhkar in this category.\",\"athkar_eyebrow\":\"Hisnul Muslim\",\"athkar_lede\":\"Morning and evening adhkar and supplications from Quran and Sunnah.\",\"athkar_of\":\"of\",\"athkar_reset\":\"Reset\",\"athkar_search_category\":\"Search category...\",\"athkar_tap_count\":\"Tap to count\",\"athkar_title\":\"Adhkar & Supplications\",\"aya_count\":\"Bilang ng mga Verse\",\"ayah\":\"Talata\",\"ayah_band_ref\":\"Surah Al-Isra · Verse 82\",\"ayah_band_text\":\"And We send down of the Quran that which is a healing and a mercy for the believers\",\"ayah_copied\":\"Nakopya ang talata\",\"ayahs\":\"Mga Talata\",\"azkar\":\"Athkar\",\"book_back\":\"Back\",\"book_back_to_library\":\"Back to Library\",\"book_error\":\"Failed to load page.\",\"book_loading\":\"Loading page...\",\"book_next\":\"Next\",\"book_of\":\"of\",\"book_page\":\"Page\",\"book_prev\":\"Previous\",\"book_retry\":\"Retry\",\"book_toc\":\"Index\",\"book_toc_empty\":\"No index for this book.\",\"book_unavailable_desc\":\"We could n