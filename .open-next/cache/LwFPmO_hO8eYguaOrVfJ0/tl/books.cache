6wig.js\",\"/_next/static/chunks/2dqrjpfd0ys2-.js\",\"/_next/static/chunks/02s4_i_2q0oq9.js\"],\"BooksPageContent\"]\n5:[\"$\",\"$L10\",null,{}]\n11:I[75696,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/1kmzfrn9ymvcu.js\",\"/_next/static/chunks/3qssvey5t78f1.js\",\"/_next/static/chunks/25lxdbndxci5v.js\",\"/_next/static/chunks/1ijqylqiu6wig.js\"],\"default\"]\nb:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"2\",{\"name\":\"theme-color\",\"content\":\"#fbf7ee\"}]]\n12:T40c,◉ Ang application na ito ay nagbibigay sa iyo ng kakayahang i-save ang inyong mga paboritong athkar sa isang espesyal na listahan, na ginagawa silang madaling ma-access at ma-review anumang oras.\n◉ Maaari mong kontrolin ang laki ng font at palakihin o paliitin ito ayon sa inyong preference para sa mas komportableng pagbabasa.\n◉ Ang application ay nag-aalok din ng tatlong modes para sa user interface - luntian, asul, at madilim - na nagbibigay sa iyo ng kakayahang i-customize ang hitsura ng app ayon sa inyong mga kagustuhan.\n◉ Ang nagpapangilin sa \"Mga Athkar Ko mula sa Libro at Sunnah\" ay ang kakayahang madaling magbahagi ng mga athkar sa mga kaibigan at pamilya.\n◉ Maaari kang magbahagi nang direkta sa text o sa pamamagitan ng pagpapadala ng larawan na naglalaman ng zikr, na ginagawang mas mayaman at malalim ang karanasan ng komunikasyon at pakikipag-ugnayan sa iba.\n◉ Maaari mong tukuyin ang mga oras na mas gusto mong basahin ang mga athkar, at papaalalahanin ka ng application sa mga oras na iyon nang tumpak.13:T5f2,◉ Ang application na ito ay nagbibigay-daan sa iyo na basahin ang Quran na parang binabasa mo sa Mushaf, at maaari mong basahin sa vertical at horizontal mode.\n◉ Maaari ka ring magbasa sa variable mode na nagbibigay-daan sa iyo na mag-zoom in at zoom out ayon sa inyong gusto.\n◉ Ang application ay may feature ng text search sa mga verses ng Quran sa pamamagitan ng instant search at pagpapakita ng mga resulta kasama ang mga pahina at ang posibilidad na pumunta sa pahina.\n◉ Pagdadagdag ng mga bookmark para sa pagbabasa upang makapag-save ang reader ng pahina at makabalik dito kahit kailan niya gusto.\n◉ Pagdadagdag ng mga notes.\n◉ Pakikinig sa bawat verse sa boses ng iba't ibang mga Qari.\n◉ Ang app ay nagbibigay ng tafsir para sa bawat verse, maaari mong baguhin ang pagitan ng mga tafsir at maaari mong baguhin ang laki ng font ng tafsir.\n◉ Index ng mga Surah.\n◉ Madaling pag-navigate sa pagitan ng mga Surah.\n◉ Ang app ay nagbibigay-daan sa iyo na basahin ang mga stop signs.\n◉ Ang application ay nagbibigay-daan sa iyo na basahin ang Hisnul Muslim nang buo at nahahati ayon sa mga athkar upang madaling mag-navigate ang reader sa pagitan ng mga seksyon, at maaari mong idagdag ang anumang zikr sa mga paborito.\n◉ Ang application ay nagbibigay-daan sa reader na magbasa ng pagbabago ng mga pattern ng kulay kasama ang dark pattern na nagbabago ng kulay ng background sa itim at mga puting linya upang bigyan ang reader ng kumpletong kaginhawahan kapag nagbabasa sa low-light na kapaligiran.4:[\"$\",\"$L11\",null,{\"formats\":\"$undefined\",\"locale\":\"tl\",\"messages\":{\"about\":\"About\",\"about_app\":\"Tungkol sa App\",\"about_app2\":\"Mga pinakamahalagang katangian ng program:\",\"about_body\":\"Kami ay isang library na dalubhasa sa pag-develop at paggawa ng applications na may Islamic at educational na karakter. Layunin namin na magbigay ng maaasahang at madaling gamitin na digital solutions na tumutulong sa mga Muslim na magbasa, matuto, at manatiling committed sa pag-alala sa Allah sa pamamagitan ng mga magagandang at refined na technical experiences. Nakatuon kami sa mataas na performance, accessibility, at multi-platform support upang masiguro na maabot ang mga benepisyo sa pinakamaraming users.\",\"about_contact_cta\":\"Natutuwa kaming marinig kayo — sulat sa amin sa ibaba:\",\"about_eyebrow\":\"About Us\",\"about_hadith_ref\":\"Narrated by Muslim\",\"about_hadith_text\":\"“Whoever follows a path seeking knowledge, Allah will make easy for him a path to Paradise”\",\"about_head\":\"Al Heekmah Library\",\"about_p1\":\"Alheekmah Library is a comprehensive Islamic platform, born from a passion to serve the Book of Allah and the Sunnah of His Prophet ﷺ. We believe that beneficial knowledge is a trust that must reach every home through the easiest and most beautiful means.\",\"about_p2\":\"We combine the authenticity of content with the beauty of experience, to bring you the Quran with its recitations, Adhkar, and selected books — in one harmonious interface.\",\"about_page_eyebrow\":\"About Us\",\"about_page_lede\":\"A comprehensive Islamic platform for spreading beneficial knowledge.\",\"about_page_story_1\":\"Alheekmah Library was born from a passion to serve the Book of Allah and the Sunnah of His Prophet ﷺ. We believe beneficial knowledge is a trust that must reach every home through the easiest and most beautiful means.\",\"about_page_story_2\":\"We combine content authenticity with experience beauty, to bring you the Quran with its recitations, Adhkar, and selected books — in one harmonious interface.\",\"about_page_story_3\":\"We focus on high performance, accessibility, and multi-platform support to ensure the benefit reaches the maximum number of users.\",\"about_page_title\":\"Alheekmah Library\",\"about_stat_1\":\"Downloads\",\"about_stat_2\":\"Languages\",\"about_stat_3\":\"Apps\",\"about_stat_4\":\"Free\",\"about_title\":\"Sino Kami\",\"about_title_1\":\"A message of\",\"about_title_2\":\"beneficial knowledge\",\"about_us\":\"Tungkol sa App\",\"about_value_1_desc\":\"We care about the finest details to deliver a refined experience.\",\"about_value_1_title\":\"Quality\",\"about_value_2_desc\":\"Trusted content from approved sources and reliable scholars.\",\"about_value_2_title\":\"Authenticity\",\"about_value_3_desc\":\"We put user needs first in everything we design.\",\"about_value_3_title\":\"Service\",\"about_value_4_desc\":\"Open to developers via API and open-source libraries.\",\"about_value_4_title\":\"Openness\",\"about_values_title\":\"Our Values\",\"about_vision_text\":\"To be the leading Islamic platform, in Arabic and internationally, in spreading beneficial knowledge through refined user experience and trusted content.\",\"about_vision_title\":\"Our Vision\",\"aboutAzkaryApp3\":\"$12\",\"aboutBook\":\"Tungkol sa Libro\",\"aboutBooks\":\"Tungkol sa Libro\",\"aboutQuranApp3\":\"$13\",\"aboutSurah\":\"Tungkol sa Surah\",\"action_browse\":\"Browse\",\"action_listen\":\"Listen\",\"action_read\":\"Read\",\"action_review\":\"Review\",\"allBooks\":\"Lahat ng mga Libro\",\"app_hisn_desc\":\"Adhkar and supplications from the Quran and Sunnah, in a practical daily format that helps you persist.\",\"app_hisn_title\":\"Hisnul Muslim\",\"app_not_found\":\"Hindi nahanap ang hiniling na app.\",\"app_qalaid_desc\":\"A digital library of selected Islamic books and beneficial knowledge, at your fingertips anytime.\",\"app_qalaid_title\":\"Al-Qalaid\",\"app_quran_desc\":\"A comprehensive app for reading the Holy Quran with recitations, tafsir, and translation for every verse.\",\"app_quran_title\":\"Holy Quran\",\"appGallery\":\"I-download mula sa |App Gallery|\",\"appLang\":\"Wika ng App\",\"appName\":\"Al Heekmah Library\",\"apps\":\"Our Apps\",\"apps_error\":\"Failed to load apps. Try again later.\",\"apps_eyebrow\":\"Our Apps\",\"apps_lede\":\"Apps carefully designed to accompany your daily life and be your companion on the path to Allah.\",\"apps_loading\":\"Loading apps...\",\"apps_page_eyebrow\":\"Our Apps\",\"apps_page_lede\":\"Islamic apps carefully designed to accompany your daily life.\",\"apps_page_title\":\"Apps Family\",\"apps_title_1\":\"From the\",\"apps_title_2\":\"Alheekmah\",\"apps_view_details\":\"View details\",\"appStoreD\":\"I-download mula sa |App Store| para sa Desktop\",\"appStoreI\":\"I-download mula sa |App Store|\",\"athkar\":\"Athkar\",\"athkar_copied\":\"Copied\",\"athkar_copy\":\"Copy\",\"athkar_count_label\":\"Repeat\",\"athkar_done\":\"Done, alhamdulillah\",\"athkar_empty\":\"No adhkar in this category.\",\"athkar_eyebrow\":\"Hisnul Muslim\",\"athkar_lede\":\"Morning and evening adhkar and supplications from Quran and Sunnah.\",\"athkar_of\":\"of\",\"athkar_reset\":\"Reset\",\"athkar_search_category\":\"Search category...\",\"athkar_tap_count\":\"Tap to count\",\"athkar_title\":\"Adhkar & Supplications\",\"aya_count\":\"Bilang ng mga Verse\",\"ayah\":\"Talata\",\"ayah_band_ref\":\"Surah Al-Isra · Verse 82\",\"ayah_band_text\":\"And We send down of the Quran that which is a healing and a mercy for the believers\",\"ayah_copied\":\"Nakopya ang talata\",\"ayahs\":\"Mga Talata\",\"azkar\":\"Athkar\",\"book_back\":\"Back\",\"book_back_to_library\":\"Back to Library\",\"book_error\":\"Failed to load page.\",\"book_loading\":\"Loading page...\",\"book_next\":\"Next\",\"book_of\":\"of\",\"book_page\":\"Page\",\"book_prev\":\"Previous\",\"book_retry\":\"Retry\",\"book_toc\":\"Index\",\"book_toc_empty\":\"No index for this book.\",\"book_unavailable_desc\":\"We could not load this book content. The file may be temporarily unavailable.\",\"book_unavailable_title\":\"Failed to Load Book\",\"bookJuz\":\"Mga Bahagi ng Libro\",\"bookmarks\":\"Mga Bookmark\",\"bookRemovedFromLastRead\":\"Natanggal ang libro sa huling binasa\",\"books\":\"Library\",\"books_empty\":\"No books match your search.\",\"books_eyebrow\":\"Islamic Library\",\"books_featured\":\"Featured\",\"books_lede\":\"A comprehensive library of tafsir, hadith, fiqh, aqeedah, seerah and other Islamic sciences.\",\"books_pages\":\"pages\",\"books_search_placeholder\":\"Search books or authors...\",\"books_six_books\":\"The Six Books\",\"books_tab_all\":\"All\",\"books_tab_hadiths\":\"Hadith\",\"books_tab_tafsir\":\"Tafsir\",\"books_title\":\"Islamic Library\",\"books_type_hadiths\":\"Hadith\",\"books_type_tafsir\":\"Tafsir\",\"brown\":\"Brown Mode\",\"changeTheme\":\"Baguhin ang Theme\",\"chapter\":\"Kabanata\",\"chapterBook\":\"Mga Kabanata ng Libro\",\"contact_email\":\"Email Address\",\"contact_email_label\":\"Email\",\"contact_email_ph\":\"example@email.com\",\"contact_error\":\"Hindi naipadala ang mensahe. Subukan ulit mamaya.\",\"contact_head\":\"Simulan natin ang inyong susunod na project\",\"contact_info_desc\":\"We value your feedback and suggestions to improve our services.\",\"contact_info_title\":\"Contact Information\",\"contact_message\":\"Inyong Mensahe\",\"contact_message_ph\":\"Write your message here...\",\"contact_name\":\"Buong Pangalan\",\"contact_name_ph\":\"Enter your full name\",\"contact_page_eyebrow\":\"Contact Us\",\"contact_page_lede\":\"Send us your message and we will reply as soon as possible.\",\"contact_page_title\":\"We Are Here to Listen\",\"contact_quote\":\"“And who is better in speech than one who invites to Allah”\",\"contact_subject\":\"Paksa\",\"contact_subject_ph\":\"Message subject\",\"contact_success\":\"Matagumpay na naipadala ang inyong mensahe.\",\"contact_title\":\"Makipag-ugnayan\",\"copyAyah\":\"Nakopya ang Verse\",\"copyAzkarText\":\"Nakopya ang Zikr\",\"CreateAnAPIKey\":\"Gumawa ng API Key\",\"cta_athkar\":\"Athkar\",\"cta_books\":\"Mga Libro\",\"cta_our_apps\":\"Aming mga app\",\"cta_quran\":\"Ang Banal na Quran\",\"cta_start_project\":\"Simulan ang inyong project\",\"cta_start_reading\":\"Start Reading\",\"dark\":\"Dark Mode\",\"delete\":\"Tanggalin\",\"detecting_platform\":\"Tinutukoy ang inyong platform para sa automatic redirection...\",\"developers_api\":\"API\",\"developers_base_url\":\"Base URL:\",\"developers_dashboard\":\"Developers Dashboard\",\"developers_dashboard_hint\":\"Upload or paste the JSON to review data and export the final file.\",\"developers_docs\":\"Documentation\",\"developers_download\":\"Download\",\"developers_empty\":\"No data available.\",\"developers_endpoints\":\"Endpoints\",\"developers_export_done\":\"File exported.\",\"developers_export_json\":\"Export JSON\",\"developers_github\":\"GitHub\",\"developers_items_count\":\"Items:\",\"developers_json_empty\":\"File is empty.\",\"developers_json_hint\":\"Paste developers.json content here...\",\"developers_json_invalid\":\"Invalid JSON file.\",\"developers_json_valid\":\"JSON is valid.\",\"developers_libraries\":\"Libraries\",\"developers_library\":\"Library\",\"developers_open\":\"Open\",\"developers_open_dashboard\":\"Open Dashboard\",\"developers_page_eyebrow\":\"Developers\",\"developers_page_lede\":\"Libraries, APIs, and downloads to help you build your apps.\",\"developers_page_title\":\"Built for Developers\",\"developers_preview\":\"Sections Preview\",\"developers_preview_empty\":\"No preview yet.\",\"developers_readme\":\"Library README\",\"developers_readme_error\":\"Failed to load README.\",\"developers_readme_url\":\"README URL\",\"developers_sections_count\":\"Sections:\",\"developers_title\":\"Developers\",\"developers_updated\":\"Last update:\",\"developers_upload_json\":\"Upload JSON\",\"developers_validate_json\":\"Validate\",\"developers_version\":\"Version:\",\"developers_view_docs\":\"View full documentation\",\"download_page_title\":\"I-download ang App\",\"downloads\":\"Downloads\",\"dwaaDaily\":\"Dua ng Araw\",\"Email\":\"Email\",\"Error\":\"Error\",\"errorLoadingData\":\"Error sa pag-load ng data\",\"faq\":\"FAQ\",\"faq_a1\":\"Mula sa theme icon sa upper bar.\",\"faq_a10\":\"Pinapangalagaan namin ang privacy ng inyong data at hindi namin ito ibinabahagi sa third parties, at gumagamit kami ng trusted infrastructure.\",\"faq_a11\":\"Bank transfer at common electronic payment gateways depende sa bansa.\",\"faq_a12\":\"Mula sa \\\"Contact\\\" tab sa loob ng website, ang inyong mensahe ay direktang naaabot sa aming team nang hindi binubuksan ang mail app.\",\"faq_a2\":\"Ang ilang mga seksyon ay gumagana nang walang internet pagkatapos ng initial loading.\",\"faq_a3\":\"Mula sa search box o mula sa Quran tab.\",\"faq_a4\":\"Oo, ang interface ay responsive para sa lahat ng laki.\",\"faq_a5\":\"Magpadala sa amin ng summary sa pamamagitan ng \\\"Simulan ang inyong project\\\" na button at babalik kami sa inyo sa loob ng 24-48 oras na may malinaw na mga hakbang.\",\"faq_a6\":\"Target namin ang iOS, Android, at Web mula sa isang codebase na may optimization para sa bawat platform.\",\"faq_a7\":\"Depende sa laki at saklaw ng project; karaniwang 2 hanggang 8 linggo para sa maliliit at medium na mga project.\",\"faq_a8\":\"Ayon sa saklaw at mga kinakailangang features. Nagpapadala kami ng detalyadong price quote pagkatapos maintindihan ang mga requirements.\",\"faq_a9\":\"Oo, nag-o-offer kami ng monthly maintenance plans o on-demand para sa mga updates, improvements, at bug fixes.\",\"faq_api_a\":\"Yes, we provide the open-source quran_library, and an API for the Quran dataset. Developers can explore them from the \\\"Developers\\\" section.\",\"faq_api_q\":\"Do you offer an API for developers?\",\"faq_apps_a\":\"Yes, all our apps are available on the Apple App Store, Google Play, and Huawei AppGallery. You can browse them from the \\\"Our Apps\\\" section.\",\"faq_apps_q\":\"Are the apps available on iOS and Android?\",\"faq_contact_a\":\"You can contact us via the \\\"Contact Us\\\" page, and we are happy to hear your feedback and suggestions to improve our services.\",\"faq_contact_q\":\"How can I contact you?\",\"faq_data_a\":\"We source our data from trusted and approved sources, and provide part of it to developers via an open API.\",\"faq_data_q\":\"Where does your data come from?\",\"faq_eyebrow\":\"FAQ\",\"faq_free_a\":\"Yes, all Alheekmah Library services are completely free and free of annoying ads. We aim to spread beneficial knowledge without any financial obstacles, as a dedication for the sake of Allah.\",\"faq_free_q\":\"Is Alheekmah Library completely free to use?\",\"faq_lede\":\"Everything you want to know about Alheekmah Library and its services.\",\"faq_offline_a\":\"Our mobile apps work offline after the initial download. The website requires a connection.\",\"faq_offline_q\":\"Can I use the apps offline?\",\"faq_page_eyebrow\":\"FAQ\",\"faq_page_lede\":\"Answers to the most common questions about Alheekmah Library.\",\"faq_page_title\":\"Everything You Need to Know\",\"faq_q1\":\"Paano magpalit sa pagitan ng light at dark theme?\",\"faq_q10\":\"Paano ang tungkol sa data privacy?\",\"faq_q11\":\"Anong mga payment methods ang available?\",\"faq_q12\":\"Paano makikipag-ugnayan sa inyo nang direkta?\",\"faq_q2\":\"Gumagana ba ito nang walang internet?\",\"faq_q3\":\"Paano maghanap sa loob ng Quran?\",\"faq_q4\":\"May mode ba para sa phone at computer?\",\"faq_q5\":\"Paano magsisimula ng app project kasama ninyo?\",\"faq_q6\":\"Anong mga platform ang inyong sinusuportahan?\",\"faq_q7\":\"Gaano katagal ang application development?\",\"faq_q8\":\"Paano natutukoy ang presyo?\",\"faq_q9\":\"Nagbibigay ba kayo ng maintenance at updates?\",\"faq_tafsir_a\":\"Yes, we provide multiple tafsirs (Ibn Kathir, Al-Muyassar, Al-Saadi...) and translations in more than 10 languages, with the ability to switch between them easily while reading.\",\"faq_tafsir_q\":\"Is tafsir and translation available for the Holy Quran?\",\"faq_title\":\"Mga Madalas na Tanong\",\"faq_title_1\":\"Answers to your\",\"faq_title_2\":\"questions\",\"feature_clean_title\":\"Ad-free experience\",\"feature_multilang_title\":\"Multilingual\",\"feature_opensource_title\":\"Open for developers\",\"feature_trusted_title\":\"Trusted content\",\"footer_desc\":\"A comprehensive Islamic platform for spreading beneficial knowledge and serving the Book of Allah and the Sunnah of His Prophet ﷺ, through trusted content and a refined user experience.\",\"footer_made_with\":\"Crafted with care to serve the Book of Allah\",\"footnotes\":\"Mga Talababa\",\"goToStartOfJuz\":\"Pumunta sa simula ng bahagi\",\"greenBookmarks\":\"Berdeng Mga Bookmark\",\"hadiths\":\"Hadith\",\"hero_ayah_ref\":\"Surah Ar-Ra'd · 28\",\"hero_ayah_text\":\"“Verily, in the remembrance of Allah do hearts find rest”\",\"hero_badge\":\"Comprehensive Islamic Platform\",\"hero_subtitle\":\"Ginagawa namin ang inyong ideya bilang pinong digital na karanasan na gumagana nang maayos sa iOS, Android, Web, at Desktop na may mataas na kalidad at performance.\",\"hero_title\":\"Gumagawa kami ng propesyonal na apps para sa mobile, web, at desktop\",\"hero_title_1\":\"Where the\",\"hero_title_2\":\"Quran\",\"hero_title_3\":\"is recited and wisdom is written\",\"hizb\":\"Hizb\",\"home\":\"Home\",\"index\":\"Indeks\",\"invalid_email\":\"Hindi valid ang email address\",\"juz\":\"Juz\",\"juzz\":\"Mga Bahagi\",\"last_listen\":\"Huling Pakikinig\",\"lastRead\":\"Huling Binasa\",\"myLibrary\":\"Aking Library\",\"ninthBooks\":\"Ikasiyam na mga Libro\",\"no_bookmarks_yet\":\"Walang bookmark pa\",\"noBooksDownloaded\":\"Wala pang mga libro na na-download\",\"noBooksFoundForSearch\":\"Walang nahanap na mga libro para sa search na ito.\",\"noBooksReadedYet\":\"Wala pang mga libro na nabasa\",\"noChaptersInThisJuz\":\"Walang mga kabanata sa bahaging ito\",\"noPagesFound\":\"Walang nahanap na mga pahina para sa librong ito.\",\"not_found_ayah\":\"“And whoever fears Allah — He will make for him a way out and will provide for him from where he does not expect”\",\"not_found_ayah_ref\":\"Surah At-Talaq · 2-3\",\"not_found_desc\":\"Sorry, the page you are looking for does not exist or has been moved. You might find what you are looking for in the links below.\",\"not_found_home\":\"Back to Home\",\"not_found_title\":\"Page Not Found\",\"open_store_button\":\"Buksan ang Store Ngayon\",\"ourApps\":\"Aming mga App\",\"page\":\"pahina\",\"pages\":\"mga pahina\",\"playStore\":\"I-download mula sa |Google Store|\",\"quick_links\":\"Quick Links\",\"quran\":\"Ang Banal na Quran\",\"quran_iframe_error\":\"Failed to load the Quran section. Try refreshing the page.\",\"quran_loading\":\"Loading the Holy Quran...\",\"quran_sounds\":\"Audio Quran\",\"reader1\":\"Abdul Basit Abdul Samad\",\"reader2\":\"Muhammad Siddiq Al-Minshawi\",\"reader3\":\"Mahmoud Khalil Al-Hussary\",\"reader5\":\"Maher Al-Muaiqly\",\"reader6\":\"Saad Al-Ghamdi\",\"readers\":\"Mga Mambabasa\",\"readLess\":\"Magbasa ng kaunti\",\"readMore\":\"Magbasa pa\",\"redBookmarks\":\"Pulang Mga Bookmark\",\"redirecting_store\":\"Mare-redirect kayo sa tamang store sa ilang sandali...\",\"required_field\":\"Kinakailangan ang field na ito\",\"sajda\":\"Sujud\",\"search\":\"Maghanap\",\"searchInBooks\":\"Maghanap sa mga libro\",\"select_player\":\"Pumili ng Qari\",\"send\":\"Ipadala\",\"sending\":\"Ipinapadala...\",\"service_azkar_desc\":\"Morning and evening adhkar and Hisnul Muslim, in a practical format that helps you persist.\",\"service_books_desc\":\"A valuable library of books, hadith, and tafsir, carefully curated for you.\",\"service_quran_desc\":\"Reading in Uthmani script with tafsir and translation for every verse.\",\"service_sound_desc\":\"Listen with a selection of renowned reciters, with repeat and bookmarking.\",\"services\":\"Services\",\"services_eyebrow\":\"Our Services\",\"services_head\":\"Ano ang aming ino-offer?\",\"services_lede\":\"Four integrated services that guide you on a spiritual journey from reading to listening to remembrance.\",\"services_title\":\"Mga Serbisyo\",\"services_title_1\":\"Gates of\",\"services_title_2\":\"Wisdom\",\"sixthBooks\":\"Ikaanim na mga Libro\",\"stat_languages\":\"Languages\",\"stat_pages\":\"Quran pages\",\"stat_reciters\":\"Reciters\",\"stat_surahs\":\"Surahs\",\"surahNames\":\"Mga Pangalan ng Surah\",\"surahs\":\"Mga Surah\",\"svc_apps\":\"Paggawa ng Application\",\"svc_apps_desc\":\"Gumagawa kami ng modernong mobile applications na may mataas na performance at komportableng user experience.\",\"svc_azkar\":\"Athkar\",\"svc_azkar_desc\":\"Araw-araw na athkar na may magandang organisasyon at malumanay na notifications.\",\"svc_books\":\"Mga Libro\",\"svc_books_desc\":\"Koleksyon ng mga kapaki-pakinabang na libro at references.\",\"svc_multi\":\"Multi-platform Support\",\"svc_multi_desc\":\"Target namin ang iOS, Android, at Web mula sa isang codebase na may optimization para sa bawat platform.\",\"svc_pro\":\"Propesyonalismo sa Trabaho\",\"svc_pro_desc\":\"Kalidad sa pagpapatupad, pagsunod sa deadline, at attention sa mga detalye mula sa simula hanggang sa paglabas.\",\"svc_quran\":\"Mushaf Text\",\"svc_quran_desc\":\"Advanced na pagbabasa at browsing na may search at mabilis na navigation.\",\"tafsir\":\"Tafsir\",\"tafsirIsEmptyNote\":\"\\n\\nAng interpretasyon ng talatang ito ay nasa mga nakaraang talata\",\"translate\":\"Mga Pagsasalin\",\"translation\":\"Ang Salin\",\"yellowBookmarks\":\"Dilaw na Mga Bookmark\",\"developers_loading\":\"Loading developer data...\",\"developers_error\":\"Failed to load developer data. Try again later.\",\"developers_view_details\":\"View details\",\"book_font_larger\":\"Increase font size\",\"book_font_smaller\":\"Decrease font size\",\"book_opening\":\"Opening the book...\",\"book_opening_desc\":\"Loading the book pages from the library. This may take a moment.\",\"company\":\"Company\",\"books_last_read\":\"Last Read\"},\"now\":\"$undefined\",\"timeZone\":\"America/Los_Angeles\",\"children\":\"$L14\"}]\n15:I[82102,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/1kmzfrn9ymvcu.js\",\"/_next/static/chunks/3qssvey5t78f1.js\",\"/_next/static/chunks/25lxdbndxci5v.js\",\"/_next/static/chunks/1ijqylqiu6wig.js\"],\"ThemeProvider\"]\n16:I[22175,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/1kmzfrn9ymvcu.js\",\"/_next/static/chunks/3qssvey5t78f1.js\",\"/_next/static/chunks/25lxdbndxci5v.js\",\"/_next/static/chunks/1ijqylqiu6wig.js\"],\"SmoothScrollProvider\"]\n17:I[39463,[\"/_next/static/chunk