"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"relative overflow-hidden rounded-3xl border border-emerald/15 bg-paper p-10 text-center lg:p-16\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"pointer-events-none absolute right-8 top-6 opacity-[0.05]\\\",\\\"children\\\":[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-naskh text-[7rem] leading-none text-emerald\\\",\\\"children\\\":\\\"۞\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"relative z-10 mx-auto max-w-2xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"eyebrow\\\",\\\"children\\\":\\\"Our Vision\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-5 text-[1.2rem] leading-[2.2] text-ink\\\",\\\"children\\\":\\\"To be the leading Islamic platform, in Arabic and internationally, in spreading beneficial knowledge through refined user experience and trusted content.\\\"}]]}]]}]}]}]\\n\"])</script><script>self.__next_f.push([1,\"19:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[0.82rem] leading-relaxed text-ink-soft\\\",\\\"children\\\":\\\"مكتبات وواجهات برمجية مفتوحة للمطورين\\\"}]\\n1a:[\\\"$\\\",\\\"$L18\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"iconNode\\\":[[\\\"path\\\",{\\\"d\\\":\\\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\\\",\\\"key\\\":\\\"1yiouv\\\"}],[\\\"circle\\\",{\\\"cx\\\":\\\"12\\\",\\\"cy\\\":\\\"8\\\",\\\"r\\\":\\\"6\\\",\\\"key\\\":\\\"1vp47v\\\"}]],\\\"className\\\":\\\"lucide-award h-7 w-7\\\",\\\"strokeWidth\\\":1.6}]\\n1b:[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"mb-2 font-display text-lg font-bold text-ink\\\",\\\"children\\\":\\\"Openness\\\"}]\\n1c:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[0.86rem] leading-relaxed text-ink-soft\\\",\\\"children\\\":\\\"Open to developers via API and open-source libraries.\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"1d:I[75696,[\\\"/_next/static/chunks/05-c3ty_6dwfk.js\\\",\\\"/_next/static/chunks/14mrh2-p_w84d.js\\\",\\\"/_next/static/chunks/1kmzfrn9ymvcu.js\\\",\\\"/_next/static/chunks/3qssvey5t78f1.js\\\",\\\"/_next/static/chunks/25lxdbndxci5v.js\\\",\\\"/_next/static/chunks/1ijqylqiu6wig.js\\\"],\\\"default\\\"]\\n1e:T854,◉ یہ ایپلی کیشن آپ کو قرآن مجید اس طرح پڑھنے کی سہولت فراہم کرتی ہے جیسے آپ مصحف میں پڑھ رہے ہوں، اور آپ عمودی اور افقی موڈ میں پڑھ سکتے ہیں۔\\n◉ آپ متغیر موڈ میں بھی پڑھ سکتے ہیں جو آپ کو اپنی مرضی کے مطابق زوم ان اور زوم آؤٹ کرنے کی سہولت دیتا ہے۔\\n◉ ایپلی کیشن میں قرآنی آیات میں فوری تلاش اور نتائج کو صفحات کے ساتھ دکھانے کا فیچر موجود ہے، اور ضرورت کے مطابق صفحے پر جانے کا امکان بھی ہے۔\\n◉ مطالعے کے لیے بک مارک شامل کرنا تاکہ قاری صفحہ محفوظ کر سکے اور جب چاہے واپس آ سکے۔\\n◉ نوٹس شامل کرنا۔\\n◉ ہر آیت کو مختلف قاریوں کی آواز میں سننا۔\\n◉ ایپ ہر آیت کی تفسیر فراہم کرتی ہے، آپ تفاسیر کے درمیان تبدیلی کر سکتے ہیں اور تفسیر کے فونٹ کا سائز تبدیل کر سکتے ہیں۔\\n◉ سورتوں کا انڈیکس۔\\n◉ سورتوں کے درمیان آسانی سے نیویگیٹ کرنا۔\\n◉ ایپ آپ کو وقف کے نشانات پڑھنے کی سہولت دیتی ہے۔\\n◉ یہ ایپلی کیشن آپ کو حصن المسلم مکمل پڑھنے اور اذکار کے مطابق تقسیم کرنے کی سہولت فراہم کرتی ہے تاکہ قاری کے لیے حصوں کے درمیان نیویگیٹ کرنا آسان ہو، اور آپ کوئی بھی ذکر پسندیدہ فہرست میں شامل کر سکتے ہیں۔\\n◉ ایپلی کیشن قاری کو رنگوں کے پیٹرن تبدیل کرنے کی اجازت دیتی ہے جن میں ڈارک پیٹرن شامل ہے جو بیک گراؤنڈ کا رنگ سیاہ اور سفید لائنوں میں تبدیل کر دیتا ہے تاکہ کم روشنی کے ماحول میں پڑھتے وقت قاری کو مکمل آرام مل سکے۔\"])</script><script>self.__next_f.push([1,\"4:[\\\"$\\\",\\\"$L1d\\\",null,{\\\"formats\\\":\\\"$undefined\\\",\\\"locale\\\":\\\"ur\\\",\\\"messages\\\":{\\\"about\\\":\\\"About\\\",\\\"about_app\\\":\\\"ایپ کے بارے میں\\\",\\\"about_app2\\\":\\\"پروگرام کی اہم خصوصیات:\\\",\\\"about_body\\\":\\\"ہم ایک لائبریری ہیں جو اسلامی اور تعلیمی کردار کی ایپلی کیشنز کی ترقی اور تعمیر میں مہارت رکھتی ہے۔ ہمارا مقصد قابل اعتماد اور استعمال میں آسان ڈیجیٹل حل فراہم کرنا ہے جو مسلمانوں کو خوبصورت اور بہترین تکنیکی تجربات کے ذریعے پڑھنے، سیکھنے اور اللہ کے ذکر میں پابند رہنے میں مدد کرتے ہیں۔ ہم اعلیٰ کارکردگی، رسائی، اور ملٹی پلیٹ فارم سپورٹ پر توجہ مرکوز کرتے ہیں تاکہ فوائد زیادہ سے زیادہ صارفین تک پہنچ سکیں۔\\\",\\\"about_contact_cta\\\":\\\"آپ سے بات کرکے ہمیں خوشی ہوگی — نیچے ہمیں لکھیں:\\\",\\\"about_eyebrow\\\":\\\"About Us\\\",\\\"about_hadith_ref\\\":\\\"Narrated by Muslim\\\",\\\"about_hadith_text\\\":\\\"“Whoever follows a path seeking knowledge, Allah will make easy for him a path to Paradise”\\\",\\\"about_head\\\":\\\"الحکمہ لائبریری\\\",\\\"about_p1\\\":\\\"Alheekmah Library is a comprehensive Islamic platform, born from a passion to serve the Book of Allah and the Sunnah of His Prophet ﷺ. We believe that beneficial knowledge is a trust that must reach every home through the easiest and most beautiful means.\\\",\\\"about_p2\\\":\\\"We combine the authenticity of content with the beauty of experience, to bring you the Quran with its recitations, Adhkar, and selected books — in one harmonious interface.\\\",\\\"about_page_eyebrow\\\":\\\"About Us\\\",\\\"about_page_lede\\\":\\\"A comprehensive Islamic platform for spreading beneficial knowledge.\\\",\\\"about_page_story_1\\\":\\\"Alheekmah Library was born from a passion to serve the Book of Allah and the Sunnah of His Prophet ﷺ. We believe beneficial knowledge is a trust that must reach every home through the easiest and most beautiful means.\\\",\\\"about_page_story_2\\\":\\\"We combine content authenticity with experience beauty, to bring you the Quran with its recitations, Adhkar, and selected books — in one harmonious interface.\\\",\\\"about_page_story_3\\\":\\\"We focus on high performance, accessibility, and multi-platform support to ensure the benefit reaches the maximum number of users.\\\",\\\"about_page_title\\\":\\\"Alheekmah Library\\\",\\\"about_stat_1\\\":\\\"Downloads\\\",\\\"about_stat_2\\\":\\\"Languages\\\",\\\"about_stat_3\\\":\\\"Apps\\\",\\\"about_stat_4\\\":\\\"Free\\\",\\\"about_title\\\":\\\"ہم کون ہیں\\\",\\\"about_title_1\\\":\\\"A message of\\\",\\\"about_title_2\\\":\\\"beneficial knowledge\\\",\\\"about_us\\\":\\\"ایپ کے بارے میں\\\",\\\"about_value_1_desc\\\":\\\"We care about the finest details to deliver a refined experience.\\\",\\\"about_value_1_title\\\":\\\"Quality\\\",\\\"about_value_2_desc\\\":\\\"Trusted content from approved sources and reliable scholars.\\\",\\\"about_value_2_title\\\":\\\"Authenticity\\\",\\\"about_value_3_desc\\\":\\\"We put user needs first in everything we design.\\\",\\\"about_value_3_title\\\":\\\"Service\\\",\\\"about_value_4_desc\\\":\\\"Open to developers via API and open-source libraries.\\\",\\\"about_value_4_title\\\":\\\"Openness\\\",\\\"about_values_title\\\":\\\"Our Values\\\",\\\"about_vision_text\\\":\\\"To be the leading Islamic platform, in Arabic and internationally, in spreading beneficial knowledge through refined user experience and trusted content.\\\",\\\"about_vision_title\\\":\\\"Our Vision\\\",\\\"aboutAzkaryApp3\\\":\\\"◉ یہ ایپلی کیشن آپ کو اپنے پسندیدہ اذکار کو خصوصی فہرست میں محفوظ کرنے کی سہولت فراہم کرتی ہے، جس سے وہ کسی بھی وقت آسانی سے قابل رسائی اور جائزہ لینے کے قابل ہو جاتے ہیں۔\\\\n◉ آپ فونٹ کے سائز کو کنٹرول کر سکتے ہیں اور زیادہ آرام دہ مطالعے کے لیے اپنی پسند کے مطابق اسے بڑا یا چھوٹا کر سکتے ہیں۔\\\\n◉ ایپلی کیشن یوزر انٹرفیس کے لیے تین موڈز پیش کرتی ہے - سبز، نیلا، اور ڈارک - جو آپ کو اپنی ترجیحات کے مطابق ایپ کی ظاہری شکل کو اپنی مرضی کے مطابق بنانے کی صلاحیت فراہم کرتا ہے۔\\\\n◉ \\\\\\\"کتاب و سنت سے میرے اذکار\\\\\\\" کی خصوصیت یہ بھی ہے کہ دوستوں اور خاندان کے ساتھ آسانی سے اذکار شیئر کرنے کی صلاحیت۔\\\\n◉ آپ براہ راست متن میں شیئر کر سکتے ہیں یا ذکر پر مشتمل تصویر بھیج کر شیئر کر سکتے ہیں، جو دوسروں کے ساتھ رابطے اور تعامل کے تجربے کو زیادہ مالا مال اور گہرا بناتا ہے۔\\\\n◉ آپ اذکار پڑھنے کے لیے اپنے پسندیدہ اوقات مقرر کر سکتے ہیں، اور ایپلی کیشن آپ کو ان اوقات میں درستگی سے یاد دلائے گی۔\\\",\\\"aboutBook\\\":\\\"کتاب کے بارے میں\\\",\\\"aboutBooks\\\":\\\"کتاب کے بارے میں\\\",\\\"aboutQuranApp3\\\":\\\"$1e\\\",\\\"aboutSurah\\\":\\\"سورت کے بارے میں\\\",\\\"action_browse\\\":\\\"Browse\\\",\\\"action_listen\\\":\\\"Listen\\\",\\\"action_read\\\":\\\"Read\\\",\\\"action_review\\\":\\\"Review\\\",\\\"allBooks\\\":\\\"تمام کتابیں\\\",\\\"app_hisn_desc\\\":\\\"Adhkar and supplications from the Quran and Sunnah, in a practical daily format that helps you persist.\\\",\\\"app_hisn_title\\\":\\\"Hisnul Muslim\\\",\\\"app_not_found\\\":\\\"مطلوبہ ایپ تلاش نہیں ہو سکی۔\\\",\\\"app_qalaid_desc\\\":\\\"A digital library of selected Islamic books and beneficial knowledge, at your fingertips anytime.\\\",\\\"app_qalaid_title\\\":\\\"Al-Qalaid\\\",\\\"app_quran_desc\\\":\\\"A comprehensive app for reading the Holy Quran with recitations, tafsir, and translation for every verse.\\\",\\\"app_quran_title\\\":\\\"Holy Quran\\\",\\\"appGallery\\\":\\\"|App Gallery| سے ڈاؤن لوڈ کریں\\\",\\\"appLang\\\":\\\"ایپ کی زبان\\\",\\\"appName\\\":\\\"الحکمہ لائبریری\\\",\\\"apps\\\":\\\"Our Apps\\\",\\\"apps_error\\\":\\\"Failed to load apps. Try again later.\\\",\\\"apps_eyebrow\\\":\\\"Our Apps\\\",\\\"apps_lede\\\":\\\"Apps carefully designed to accompany your daily life and be your companion on the path to Allah.\\\",\\\"apps_loading\\\":\\\"Loading apps...\\\",\\\"apps_page_eyebrow\\\":\\\"Our Apps\\\",\\\"apps_page_lede\\\":\\\"Islamic apps carefully designed to accompany your daily life.\\\",\\\"apps_page_title\\\":\\\"Apps Family\\\",\\\"apps_title_1\\\":\\\"From the\\\",\\\"apps_title_2\\\":\\\"Alheekmah\\\",\\\"apps_view_details\\\":\\\"View details\\\",\\\"appStoreD\\\":\\\"ڈیسک ٹاپ کے لیے |App Store| سے ڈاؤن لوڈ کریں\\\",\\\"appStoreI\\\":\\\"|App Store| سے ڈاؤن لوڈ کریں\\\",\\\"athkar\\\":\\\"اذکار\\\",\\\"athkar_copied\\\":\\\"Copied\\\",\\\"athkar_copy\\\":\\\"Copy\\\",\\\"athkar_count_label\\\":\\\"Repeat\\\",\\\"athkar_done\\\":\\\"Done, alhamdulillah\\\",\\\"athkar_empty\\\":\\\"No adhkar in this category.\\\",\\\"athkar_eyebrow\\\":\\\"Hisnul Muslim\\\",\\\"athkar_lede\\\":\\\"Morning and evening adhkar and supplications from Quran and Sunnah.\\\",\\\"athkar_of\\\":\\\"of\\\",\\\"athkar_reset\\\":\\\"Reset\\\",\\\"athkar_search_category\\\":\\\"Search category...\\\",\\\"athkar_tap_count\\\":\\\"Tap to count\\\",\\\"athkar_title\\\":\\\"Adhkar \\u0026 Supplications\\\",\\\"aya_count\\\":\\\"آیات کی تعداد\\\",\\\"ayah\\\":\\\"آیت\\\",\\\"ayah_band_ref\\\":\\\"Surah Al-Isra · Verse 82\\\",\\\"ayah_band_text\\\":\\\"And We send down of the Quran that which is a healing and a mercy for the believers\\\",\\\"ayah_copied\\\":\\\"آیت کاپی ہو گئی\\\",\\\"ayahs\\\":\\\"آیات\\\",\\\"azkar\\\":\\\"اذکار\\\",\\\"book_back\\\":\\\"Back\\\",\\\"book_back_to_library\\\":\\\"Back to Library\\\",\\\"book_error\\\":\\\"Failed to load page.\\\",\\\"book_loading\\\":\\\"Loading page...\\\",\\\"book_next\\\":\\\"Next\\\",\\\"book_of\\\":\\\"of\\\",\\\"book_page\\\":\\\"Page\\\",\\\"book_prev\\\":\\\"Previous\\\",\\\"book_retry\\\":\\\"Retry\\\",\\\"book_toc\\\":\\\"Index\\\",\\\"book_toc_empty\\\":\\\"No index for this book.\\\",\\\"book_unavailable_desc\\\":\\\"We could not load this book content. The file may be temporarily unavailable.\\\",\\\"book_unavailable_title\\\":\\\"Failed to Load Book\\\",\\\"bookJuz\\\":\\\"کتاب کے حصے\\\",\\\"bookmarks\\\":\\\"نشانیاں\\\",\\\"bookRemovedFromLastRead\\\":\\\"کتاب آخری مطالعے سے ہٹا دی گئی\\\",\\\"books\\\":\\\"Library\\\",\\\"books_empty\\\":\\\"No books match your search.\\\",\\\"books_eyebrow\\\":\\\"Islamic Library\\\",\\\"books_featured\\\":\\\"Featured\\\",\\\"books_lede\\\":\\\"A comprehensive library of tafsir, hadith, fiqh, aqeedah, seerah and other Islamic sciences.\\\",\\\"books_pages\\\":\\\"pages\\\",\\\"books_search_placeholder\\\":\\\"Search books or authors...\\\",\\\"books_six_books\\\":\\\"The Six Books\\\",\\\"books_tab_all\\\":\\\"All\\\",\\\"books_tab_hadiths\\\":\\\"Hadith\\\",\\\"books_tab_tafsir\\\":\\\"Tafsir\\\",\\\"books_title\\\":\\\"Islamic Library\\\",\\\"books_type_hadiths\\\":\\\"Hadith\\\",\\\"books_type_tafsir\\\":\\\"Tafsir\\\",\\\"brown\\\":\\\"بھورا موڈ\\\",\\\"changeTheme\\\":\\\"تھیم تبدیل کریں\\\",\\\"chapter\\\":\\\"باب\\\",\\\"chapterBook\\\":\\\"کتاب کے ابواب\\\",\\\"contact_email\\\":\\\"ای میل ایڈریس\\\",\\\"contact_email_label\\\":\\\"Email\\\",\\\"contact_email_ph\\\":\\\"example@email.com\\\",\\\"contact_error\\\":\\\"پیغام بھیجنے میں ناکامی۔ بعد میں کوشش کریں۔\\\",\\\"contact_head\\\":\\\"آئیے آپ کا اگلا پروجیکٹ شروع کرتے ہیں\\\",\\\"contact_info_desc\\\":\\\"We value your feedback and suggestions to improve our services.\\\",\\\"contact_info_title\\\":\\\"Contact Information\\\",\\\"contact_message\\\":\\\"آپ کا پیغام\\\",\\\"contact_message_ph\\\":\\\"Write your message here...\\\",\\\"contact_name\\\":\\\"مکمل نام\\\",\\\"contact_name_ph\\\":\\\"Enter your full name\\\",\\\"contact_page_eyebrow\\\":\\\"Contact Us\\\",\\\"contact_page_lede\\\":\\\"Send us your message and we will reply as soon as possible.\\\",\\\"contact_page_title\\\":\\\"We Are Here to Listen\\\",\\\"contact_quote\\\":\\\"“And who is better in speech than one who invites to Allah”\\\",\\\"contact_subject\\\":\\\"موضوع\\\",\\\"contact_subject_ph\\\":\\\"Message subject\\\",\\\"contact_success\\\":\\\"آپ کا پیغام کامیابی سے بھیج دیا گیا ہے۔\\\",\\\"contact_title\\\":\\\"رابطہ\\\",\\\"copyAyah\\\":\\\"آیت کاپی ہو گئی\\\",\\\"copyAzkarText\\\":\\\"ذکر کاپی ہو گیا\\\",\\\"CreateAnAPIKey\\\":\\\"API کلید بنائیں\\\",\\\"cta_athkar\\\":\\\"اذکار\\\",\\\"cta_books\\\":\\\"کتابیں\\\",\\\"cta_our_apps\\\":\\\"ہماری ایپس\\\",\\\"cta_quran\\\":\\\"قرآن مجید\\\",\\\"cta_start_project\\\":\\\"اپنا پروجیکٹ شروع کریں\\\",\\\"cta_start_reading\\\":\\\"Start Reading\\\",\\\"dark\\\":\\\"ڈارک موڈ\\\",\\\"delete\\\":\\\"ڈیلیٹ\\\",\\\"detecting_platform\\\":\\\"خودکار ری ڈائریکشن کے لیے آپ کا پلیٹ فارم تلاش کیا جا رہا ہے...\\\",\\\"developers_api\\\":\\\"API\\\",\\\"developers_base_url\\\":\\\"Base URL:\\\",\\\"developers_dashboard\\\":\\\"Developers Dashboard\\\",\\\"developers_dashboard_hint\\\":\\\"Upload or paste the JSON to review data and export the final file.\\\",\\\"developers_docs\\\":\\\"Documentation\\\",\\\"developers_download\\\":\\\"Download\\\",\\\"developers_empty\\\":\\\"No data available.\\\",\\\"developers_endpoints\\\":\\\"Endpoints\\\",\\\"developers_export_done\\\":\\\"File exported.\\\",\\\"developers_export_json\\\":\\\"Export JSON\\\",\\\"developers_github\\\":\\\"GitHub\\\",\\\"developers_items_count\\\":\\\"Items:\\\",\\\"developers_json_empty\\\":\\\"File is empty.\\\",\\\"developers_json_hint\\\":\\\"Paste developers.json content here...\\\",\\\"developers_json_invalid\\\":\\\"Invalid JSON file.\\\",\\\"developers_json_valid\\\":\\\"JSON is valid.\\\",\\\"developers_libraries\\\":\\\"Libraries\\\",\\\"developers_library\\\":\\\"Library\\\",\\\"developers_open\\\":\\\"Open\\\",\\\"developers_open_dashboard\\\":\\\"Open Dashboard\\\",\\\"developers_page_eyebrow\\\":\\\"Developers\\\",\\\"developers_page_lede\\\":\\\"Libraries, APIs, and downloads to help you build your apps.\\\",\\\"developers_page_title\\\":\\\"Built for Developers\\\",\\\"developers_preview\\\":\\\"Sections Preview\\\",\\\"developers_preview_empty\\\":\\\"No preview yet.\\\",\\\"developers_readme\\\":\\\"Library README\\\",\\\"developers_readme_error\\\":\\\"Failed to load README.\\\",\\\"developers_readme_url\\\":\\\"README URL\\\",\\\"developers_sections_count\\\":\\\"Sections:\\\",\\\"developers_title\\\":\\\"Developers\\\",\\\"developers_updated\\\":\\\"Last update:\\\",\\\"developers_upload_json\\\":\\\"Upload JSON\\\",\\\"developers_validate_json\\\":\\\"Validate\\\",\\\"developers_version\\\":\\\"Version:\\\",\\\"developers_view_docs\\\":\\\"View full documentation\\\",\\\"download_page_title\\\":\\\"ایپ ڈاؤن لوڈ\\\",\\\"downloads\\\":\\\"Downloads\\\",\\\"dwaaDaily\\\":\\\"آج کی دعا\\\",\\\"Email\\\":\\\"ای میل\\\",\\\"Error\\\":\\\"خرابی\\\",\\\"errorLoadingData\\\":\\\"ڈیٹا لوڈ کرنے میں خرابی\\\",\\\"faq\\\":\\\"FAQ\\\",\\\"faq_a1\\\":\\\"اوپری بار میں تھیم آئیکن سے۔\\\",\\\"faq_a10\\\":\\\"ہم آپ کے ڈیٹا کی رازداری کو برقرار رکھتے ہیں اور تیسرے فریق کے ساتھ شیئر نہیں کرتے، اور قابل اعتماد انفراسٹرکچر استعمال کرتے ہیں۔\\\",\\\"faq_a11\\\":\\\"بینک ٹرانسفر اور ملک کے مطابق عام الیکٹرانک پیمنٹ گیٹ ویز۔\\\",\\\"faq_a12\\\":\\\"ویب سائٹ کے اندر \\\\\\\"رابطہ\\\\\\\" ٹیب سے، آپ کا پیغام میل ایپ کھولے بغیر براہ راست ہماری ٹیم تک پہنچتا ہے۔\\\",\\\"faq_a2\\\":\\\"کچھ حصے ابتدائی لوڈنگ کے بعد انٹرنیٹ کے بغیر کام کرتے ہیں۔\\\",\\\"faq_a3\\\":\\\"تلاش کے خانے سے یا قرآن کے ٹیب سے۔\\\",\\\"faq_a4\\\":\\\"ہاں، انٹرفیس تمام سائزز کے لیے ریسپانسو ہے۔\\\",\\\"faq_a5\\\":\\\"\\\\\\\"اپنا پروجیکٹ شروع کریں\\\\\\\" بٹن کے ذریعے ہمیں خلاصہ بھیجیں اور ہم 24-48 گھنٹوں میں واضح اقدامات کے ساتھ آپ کے پاس واپس آئیں گے۔\\\",\\\"faq_a6\\\":\\\"ہم ایک کوڈ بیس سے iOS، Android، اور ویب کو ہدف بناتے ہیں ہر پلیٹ فارم کے لیے بہتری کے ساتھ۔\\\",\\\"faq_a7\\\":\\\"یہ پروجیکٹ کے سائز اور دائرہ کار پر منحصر ہے؛ عام طور پر چھوٹے اور درمیانے پروجیکٹس کے لیے 2 سے 8 ہفتے۔\\\",\\\"faq_a8\\\":\\\"دائرہ کار اور مطلوبہ خصوصیات کے مطابق۔ ضروریات سمجھنے کے بعد ہم تفصیلی قیمت کی تجویز بھیجتے ہیں۔\\\",\\\"faq_a9\\\":\\\"ہاں، ہم اپ ڈیٹس، بہتری اور بگ فکس کے لیے ماہانہ دیکھ بھال کے منصوبے یا مانگ کے مطابق خدمات فراہم کرتے ہیں۔\\\",\\\"faq_api_a\\\":\\\"Yes, we provide the open-source quran_library, and an API for the Quran dataset. Developers can explore them from the \\\\\\\"Developers\\\\\\\" section.\\\",\\\"faq_api_q\\\":\\\"Do you offer an API for developers?\\\",\\\"faq_apps_a\\\":\\\"Yes, all our apps are available on the Apple App Store, Google Play, and Huawei AppGallery. You can browse them from the \\\\\\\"Our Apps\\\\\\\" section.\\\",\\\"faq_apps_q\\\":\\\"Are the apps available on iOS and Android?\\\",\\\"faq_contact_a\\\":\\\"You can contact us via the \\\\\\\"Contact Us\\\\\\\" page, and we are happy to hear your feedback and suggestions to improve our services.\\\",\\\"faq_contact_q\\\":\\\"How can I contact you?\\\",\\\"faq_data_a\\\":\\\"We source our data from trusted and approved sources, and provide part of it to developers via an open API.\\\",\\\"faq_data_q\\\":\\\"Where does your data come from?\\\",\\\"faq_eyebrow\\\":\\\"FAQ\\\",\\\"faq_free_a\\\":\\\"Yes, all Alheekmah Library services are completely free and free of annoying ads. We aim to spread beneficial knowledge without any financial obstacles, as a dedication for the sake of Allah.\\\",\\\"faq_free_q\\\":\\\"Is Alheekmah Library completely free to use?\\\",\\\"faq_lede\\\":\\\"Everything you want to know about Alheekmah Library and its services.\\\",\\\"faq_offline_a\\\":\\\"Our mobile apps work offline after the initial download. The website requires a connection.\\\",\\\"faq_offline_q\\\":\\\"Can I use the apps offline?\\\",\\\"faq_page_eyebrow\\\":\\\"FAQ\\\",\\\"faq_page_lede\\\":\\\"Answers to the most common questions about Alheekmah Library.\\\",\\\"faq_page_title\\\":\\\"Everything You Need to Know\\\",\\\"faq_q1\\\":\\\"روشن اور تاریک تھیم کے درمیان کیسے تبدیل کریں؟\\\",\\\"faq_q10\\\":\\\"ڈیٹا کی رازداری کے بارے میں کیا؟\\\",\\\"faq_q11\\\":\\\"کون سے ادائیگی کے طریقے دستیاب ہیں؟\\\",\\\"faq_q12\\\":\\\"آپ سے براہ راست کیسے رابطہ کریں؟\\\",\\\"faq_q2\\\":\\\"کیا یہ انٹرنیٹ کے بغیر کام کرتا ہے؟\\\",\\\"faq_q3\\\":\\\"قرآن کے اندر کیسے تلاش کریں؟\\\",\\\"faq_q4\\\":\\\"کیا فون اور کمپیوٹر کے لیے موڈ ہے؟\\\",\\\"faq_q5\\\":\\\"آپ کے ساتھ ایپ پروجیکٹ کیسے شروع کریں؟\\\",\\\"faq_q6\\\":\\\"آپ کون سے پلیٹ فارمز کو سپورٹ کرتے ہیں؟\\\",\\\"faq_q7\\\":\\\"ایپلی کیشن ڈیویلپمنٹ میں کتنا وقت لگتا ہے؟\\\",\\\"faq_q8\\\":\\\"قیمت کا تعین کیسے ہوتا ہے؟\\\",\\\"faq_q9\\\":\\\"کیا آپ دیکھ بھال اور اپ ڈیٹس فراہم کرتے ہیں؟\\\",\\\"faq_tafsir_a\\\":\\\"Yes, we provide multiple tafsirs (Ibn Kathir, Al-Muyassar, Al-Saadi...) and translations in more than 10 languages, with the ability to switch between them easily while reading.\\\",\\\"faq_tafsir_q\\\":\\\"Is tafsir and translation available for the Holy Quran?\\\",\\\"faq_title\\\":\\\"عام سوالات\\\",\\\"faq_title_1\\\":\\\"Answers to your\\\",\\\"faq_title_2\\\":\\\"questions\\\",\\\"feature_clean_title\\\":\\\"Ad-free experience\\\",\\\"feature_multilang_title\\\":\\\"Multilingual\\\",\\\"feature_opensource_title\\\":\\\"Open for developers\\\",\\\"feature_trusted_title\\\":\\\"Trusted content\\\",\\\"footer_desc\\\":\\\"A comprehensive Islamic platform for spreading beneficial knowledge and serving the Book of Allah and the Sunnah of His Prophet ﷺ, through trusted content and a refined user experience.\\\",\\\"footer_made_with\\\":\\\"Crafted with care to serve the Book of Allah\\\",\\\"footnotes\\\":\\\"حاشیہ\\\",\\\"goToStartOfJuz\\\":\\\"حصے کی شروعات پر جائیں\\\",\\\"greenBookmarks\\\":\\\"سبز نشانیاں\\\",\\\"hadiths\\\":\\\"حدیث\\\",\\\"hero_ayah_ref\\\":\\\"Surah Ar-Ra'd · 28\\\",\\\"hero_ayah_text\\\":\\\"“Verily, in the remembrance of Allah do hearts find rest”\\\",\\\"hero_badge\\\":\\\"Comprehensive Islamic Platform\\\",\\\"hero_subtitle\\\":\\\"ہم آپ کے آئیڈیے کو ایک عمدہ ڈیجیٹل تجربے میں بدلتے ہیں جو iOS، Android، ویب اور ڈیسک ٹاپ پر اعلیٰ معیار اور کارکردگی کے ساتھ بآسانی چلتا ہے۔\\\",\\\"hero_title\\\":\\\"ہم موبائل، ویب اور ڈیسک ٹاپ کے لیے پیشہ ورانہ ایپس بناتے ہیں\\\",\\\"hero_title_1\\\":\\\"Where the\\\",\\\"hero_title_2\\\":\\\"Quran\\\",\\\"hero_title_3\\\":\\\"is recited and wisdom is written\\\",\\\"hizb\\\":\\\"حزب\\\",\\\"home\\\":\\\"ہوم\\\",\\\"index\\\":\\\"فہرست\\\",\\\"invalid_email\\\":\\\"ای میل ایڈریس غلط ہے\\\",\\\"juz\\\":\\\"پارہ\\\",\\\"juzz\\\":\\\"پارے\\\",\\\"last_listen\\\":\\\"آخری سماعت\\\",\\\"lastRead\\\":\\\"آخری مطالعہ\\\",\\\"myLibrary\\\":\\\"میری لائبریری\\\",\\\"ninthBooks\\\":\\\"نویں کتابیں\\\",\\\"no_bookmarks_yet\\\":\\\"ابھی تک کوئی نشانی نہیں\\\",\\\"noBooksDownloaded\\\":\\\"ابھی تک کوئی کتاب ڈاؤن لوڈ نہیں ہوئی\\\",\\\"noBooksFoundForSearch\\\":\\\"اس تلاش کے لیے کوئی کتابیں نہیں ملیں۔\\\",\\\"noBooksReadedYet\\\":\\\"ابھی تک کوئی کتابیں نہیں پڑھی گئیں\\\",\\\"noChaptersInThisJuz\\\":\\\"اس حصے میں کوئی ابواب نہیں\\\",\\\"noPagesFound\\\":\\\"اس کتاب کے لیے کوئی صفحات نہیں ملے۔\\\",\\\"not_found_ayah\\\":\\\"“And whoever fears Allah — He will make for him a way out and will provide for him from where he does not expect”\\\",\\\"not_found_ayah_ref\\\":\\\"Surah At-Talaq · 2-3\\\",\\\"not_found_desc\\\":\\\"Sorry, the page you are looking for does not exist or has been moved. You might find what you are looking for in the links below.\\\",\\\"not_found_home\\\":\\\"Back to Home\\\",\\\"not_found_title\\\":\\\"Page Not Found\\\",\\\"open_store_button\\\":\\\"ابھی سٹور کھولیں\\\",\\\"ourApps\\\":\\\"ہماری ایپس\\\",\\\"page\\\":\\\"صفحہ\\\",\\\"pages\\\":\\\"صفحات\\\",\\\"playStore\\\":\\\"|Google Store| سے ڈاؤن لوڈ کریں\\\",\\\"quick_links\\\":\\\"Quick Links\\\",\\\"quran\\\":\\\"قرآن مجید\\\",\\\"quran_iframe_error\\\":\\\"Failed to load the Quran section. Try refreshing the page.\\\",\\\"quran_loading\\\":\\\"Loading the Holy Quran...\\\",\\\"quran_sounds\\\":\\\"Audio Quran\\\",\\\"reader1\\\":\\\"عبدالباسط عبدالصمد\\\",\\\"reader2\\\":\\\"محمد صدیق منشاوی\\\",\\\"reader3\\\":\\\"محمود خلیل حصری\\\",\\\"reader5\\\":\\\"ماہر معیقلی\\\",\\\"reader6\\\":\\\"سعد الغامدی\\\",\\\"readers\\\":\\\"قاری حضرات\\\",\\\"readLess\\\":\\\"کم پڑھیں\\\",\\\"readMore\\\":\\\"مزید پڑھیں\\\",\\\"redBookmarks\\\":\\\"سرخ نشانیاں\\\",\\\"redirecting_store\\\":\\\"آپ کو مناسب سٹور پر لمحوں میں ری ڈائریکٹ کیا جائے گا...\\\",\\\"required_field\\\":\\\"یہ فیلڈ ضروری ہے\\\",\\\"sajda\\\":\\\"سجدہ\\\",\\\"search\\\":\\\"تلاش\\\",\\\"searchInBooks\\\":\\\"کتابوں میں تلاش کریں\\\",\\\"select_player\\\":\\\"قاری منتخب کریں\\\",\\\"send\\\":\\\"بھیجیں\\\",\\\"sending\\\":\\\"بھیجا جا رہا ہے...\\\",\\\"service_azkar_desc\\\":\\\"Morning and evening adhkar and Hisnul Muslim, in a practical format that helps you persist.\\\",\\\"service_books_desc\\\":\\\"A valuable library of books, hadith, and tafsir, carefully curated for you.\\\",\\\"service_quran_desc\\\":\\\"Reading in Uthmani script with tafsir and translation for every verse.\\\",\\\"service_sound_desc\\\":\\\"Listen with a selection of renowned reciters, with repeat and bookmarking.\\\",\\\"services\\\":\\\"Services\\\",\\\"services_eyebrow\\\":\\\"Our Services\\\",\\\"services_head\\\":\\\"ہم کیا فراہم کرتے ہیں؟\\\",\\\"services_lede\\\":\\\"Four integrated services that guide you on a spiritual journey from reading to listening to remembrance.\\\",\\\"services_title\\\":\\\"خدمات\\\",\\\"services_title_1\\\":\\\"Gates of\\\",\\\"services_title_2\\\":\\\"Wisdom\\\",\\\"sixthBooks\\\":\\\"چھٹی کتابیں\\\",\\\"stat_languages\\\":\\\"Languages\\\",\\\"stat_pages\\\":\\\"Quran pages\\\",\\\"stat_reciters\\\":\\\"Reciters\\\",\\\"stat_surahs\\\":\\\"Surahs\\\",\\\"surahNames\\\":\\\"سورتوں کے نام\\\",\\\"surahs\\\":\\\"سورتیں\\\",\\\"svc_apps\\\":\\\"ایپلی کیشن بنانا\\\",\\\"svc_apps_desc\\\":\\\"ہم اعلیٰ کارکردگی اور آرام دہ صارف تجربے کے ساتھ جدید موبائل ایپلی کیشنز تیار کرتے ہیں۔\\\",\\\"svc_azkar\\\":\\\"اذکار\\\",\\\"svc_azkar_desc\\\":\\\"خوبصورت تنظیم اور نرم اطلاعات کے ساتھ روزانہ کے اذکار۔\\\",\\\"svc_books\\\":\\\"کتابیں\\\",\\\"svc_books_desc\\\":\\\"مفید کتابوں اور حوالہ جات کا مجموعہ۔\\\",\\\"svc_multi\\\":\\\"ملٹی پلیٹ فارم سپورٹ\\\",\\\"svc_multi_desc\\\":\\\"ہم ایک کوڈ بیس سے iOS، Android، اور ویب کو ہدف بناتے ہیں ہر پلیٹ فارم کے لیے بہتری کے ساتھ۔\\\",\\\"svc_pro\\\":\\\"کام میں پیشہ ورانہ مہارت\\\",\\\"svc_pro_desc\\\":\\\"عمل میں معیار، وقت کی پابندی، اور شروع سے اشاعت تک تفصیلات کا خیال۔\\\",\\\"svc_quran\\\":\\\"مصحف کا متن\\\",\\\"svc_quran_desc\\\":\\\"تلاش اور تیز نیویگیشن کے ساتھ ایڈوانس ریڈنگ اور براؤزنگ۔\\\",\\\"tafsir\\\":\\\"تفسیر\\\",\\\"tafsirIsEmptyNote\\\":\\\"\\\\n\\\\nاس آیت کی تفسیر سابقہ آیات میں ہے\\\",\\\"translate\\\":\\\"ترجمے\\\",\\\"translation\\\":\\\"ترجمہ\\\",\\\"yellowBookmarks\\\":\\\"زرد نشانیاں\\\",\\\"developers_loading\\\":\\\"Loading developer data...\\\",\\\"developers_error\\\":\\\"Failed