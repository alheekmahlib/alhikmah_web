sition-colors text-ink-soft hover:text-emerald\" href=\"/ar/sound\">المصحف الصوتي<span class=\"absolute inset-x-3.5 -bottom-0.5 h-0.5 origin-center rounded-full bg-emerald transition-transform duration-300 scale-x-0 group-hover:scale-x-100\"></span></a><a class=\"group relative rounded-lg px-3.5 py-2 text-[0.88rem] font-semibold transition-colors text-ink-soft hover:text-emerald\" href=\"/ar/books\">المكتبة<span class=\"absolute inset-x-3.5 -bottom-0.5 h-0.5 origin-center rounded-full bg-emerald transition-transform duration-300 scale-x-0 group-hover:scale-x-100\"></span></a><a class=\"group relative rounded-lg px-3.5 py-2 text-[0.88rem] font-semibold transition-colors text-ink-soft hover:text-emerald\" href=\"/ar/athkar\">الأذكار<span class=\"absolute inset-x-3.5 -bottom-0.5 h-0.5 origin-center rounded-full bg-emerald transition-transform duration-300 scale-x-0 group-hover:scale-x-100\"></span></a><a class=\"group relative rounded-lg px-3.5 py-2 text-[0.88rem] font-semibold transition-colors text-ink-soft hover:text-emerald\" href=\"/ar/apps\">تطبيقاتنا<span class=\"absolute inset-x-3.5 -bottom-0.5 h-0.5 origin-center rounded-full bg-emerald transition-transform duration-300 scale-x-0 group-hover:scale-x-100\"></span></a><a class=\"group relative rounded-lg px-3.5 py-2 text-[0.88rem] font-semibold transition-colors text-emerald\" href=\"/ar/about\">من نحن<span class=\"absolute inset-x-3.5 -bottom-0.5 h-0.5 origin-center rounded-full bg-emerald transition-transform duration-300 scale-x-100\"></span></a></div><div class=\"flex items-center gap-2\"><button aria-label=\"تغيير النمط\" data-cursor=\"hover\" class=\"grid h-9 w-9 place-items-center rounded-lg text-emerald transition-colors hover:bg-emerald/10\"><span style=\"opacity:0;transform:rotate(-90deg)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-moon h-4 w-4\" aria-hidden=\"true\"><path d=\"M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401\"></path></svg></span></button><a data-cursor=\"hover\" class=\"hidden rounded-xl bg-emerald px-4 py-2 text-[0.84rem] font-bold text-paper-fixed transition-all hover:bg-emerald md:inline-block\" href=\"/ar/contact-us\">تواصل</a><button aria-label=\"menu\" class=\"grid h-9 w-9 place-items-center rounded-lg text-emerald transition-colors hover:bg-emerald/10 lg:hidden\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-4 w-4\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></nav></header><main class=\"flex-1 pt-20 lg:pt-24\"><div style=\"opacity:0;transform:translateY(8px)\"><section class=\"container-x pt-12 lg:pt-16\"><div class=\"reveal\"><div class=\"border-b border-rule pb-6 text-center\"><span class=\"eyebrow\">من نحن</span><h1 class=\"mt-3 font-display text-[2rem] font-bold leading-tight text-ink lg:text-6\">مكتبة الحكمة</h1><p class=\"mx-auto mt-3 max-w-xl text-[1rem] text-ink-soft\">منصة إسلامية شاملة لنشر العلم النافع.</p></div></div></section><section class=\"container-x py-12\"><div class=\"grid items-center gap-12 lg:grid-cols-[1.4fr_0.6fr]\"><div><div class=\"reveal\"><p class=\"mb-5 text-[1.05rem] leading-[2] text-ink-soft\">وُلدت مكتبة الحكمة من شغفٍ بخدمة كتاب الله وسنة نبيه ﷺ. نؤمن بأن العلم النافع أمانةٌ يجب أن تصل لكل بيتٍ بأسهل الطرق وأجملها.</p></div><div class=\"reveal\" style=\"transition-delay:100ms\"><p class=\"mb-5 leading-[2] text-ink-soft\">نجمع بين أصالة المحتوى وجمال التجربة، لنقدّم لك القرآن بصوتياته ومرتليه، والأذكار، والكتب المختارة — في واجهةٍ واحدةٍ متناغمة.</p></div><div class=\"reveal\" style=\"transition-delay:200ms\"><p class=\"leading-[2] text-ink-soft\">نركز على الأداء العالي، قابلية الوصول، ودعم منصات متعددة لضمان وصول الفائدة لأكبر عدد من المستخدمين.</p></div></div><div class=\"reveal-zoom\" style=\"transition-delay:150ms\"><div class=\"relative mx-auto flex items-center justify-center py-8\"><div class=\"pointer-events-none absolute opacity-[0.08]\"><span class=\"font-naskh text-[8rem] leading-none text-emerald\">۞</span></div><div class=\"relative z-10\"><svg height=\"100\" width=\"312.1951219512195\" viewBox=\"0 0 128 41\" xmlns=\"http://www.w3.org/2000/svg\" class=\"text-emerald drop-shadow-lg\" aria-label=\"مكتبة الحكمة\" role=\"img\"><g fill=\"currentColor\" fill-rule=\"evenodd\"><path d=\"m53.3 1.3c2.7 1.8 5.9 5.2 8 8.4 6.2 9.7 3.2 22.8-5.6 24.8-2.2.5-5.7.8-5.8.5 0-.1.5-.3 2.8-1.4 5.8-2.6 6.6-3.1 8.2-4.7 2.1-1.9 2.7-3.2 2.7-6.1 0-4.1-1.4-7.8-4.6-12-2.5-3.4-6.3-6.9-6.3-5.9 0 2.6-.1 8.7-.1 9.1-.4 3.8-1 5.4-2.5 7.1-.4.4-.6.7-.5.7s.6.1 1.1.3c.6.1 1.9.5 3 .7 2.6.7 5.5 1.3 7.1 1.6 1.9.2 2 .3 1.5 1.1 0 .1-.3.5-.5 1-.5.9-.5.9-1.9.8-3.6-.3-4.7-.1-10.1 1.9-5.9 2.1-8.6 2.5-11.1 1.6-1.3-.4-1.7-.8-4.4-3.7-1.1-1.2-2.1-2.1-2.2-2 0 0 .1.6.3 1.2.4 1.3.4 1.6.2 2.4-.4 1.1-1.2 2.2-2.1 2.8-.4.3-.4.3-.1.7 1.6 2 .6 5.6-1.8 6.2-1.5.4-4-1.8-4.6-4.3l-.2-.6-.3.6c-1.2 2.7-3.2 3.6-6.1 3-1.7-.4-2.3-1-3.5-3.3-1.1-2.4-1.5-2.6-3-1.8-1.4.7-2.3 1.8-4 5-1.6 2.8-2.5 3.8-3.7 3.8-2.8 0-4.1-6-2.5-11.2l.2-.8-.2-.3c-1-.9-.6-3.5 1.1-7.2q.8-1.7 1-1.8c.1 0 .1 0-.3 1-1.5 3.1-2 5.8-1.3 6.6q.6.6 1.2-.6c.5-1 .5 0 0 1.1-.2.4-.4.8-.6.9l-.4.3-.2 1.6c-.9 5.4.2 8.7 2.7 7.9.8-.3 1.3-.9 2.8-3.5 2.3-3.9 3.9-5.7 5.6-6 1.1-.3 1.6.1 2.7 2.3s1.7 2.7 3.5 3.1c2.5.5 4.3-.5 5.7-3.3.3-.5.6-.7.9-.5.1 0 .2 0 .3-.3.2-.4.4-.5 1.8-.7 2.7-.2 4.7-.7 4.6-1.2-.6-2.4-5-7-12.9-13.7-1.8-1.5-1.7-1.3-1.5-2.5.4-1.9 1.1-3.2 1.9-3.8 4.3-2.8 19.2-7.6 22.5-7.2 2.7.3 1.8 3.1-2.2 6.8-1.5 1.4-2.2 2.1-2.8 3q-.5.8-.2-.3c.4-1.1 1.3-2.2 3.3-4.2 2.2-2.2 2.3-2.4 1.2-2.7-2.5-.6-16.8 3.9-22 7-.9.6-.9.6-.1 1 2.7 1.2 10.4 7.5 15.9 12.8 3.7 3.6 4.3 3.9 7.4 3.8 2.1-.