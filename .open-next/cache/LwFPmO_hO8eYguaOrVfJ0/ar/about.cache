xt-ink-soft\",\"children\":\"مفتوحون للمطورين عبر API ومكتبات مفتوحة المصدر.\"}]\n1c:I[75696,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/1kmzfrn9ymvcu.js\",\"/_next/static/chunks/3qssvey5t78f1.js\",\"/_next/static/chunks/25lxdbndxci5v.js\",\"/_next/static/chunks/1ijqylqiu6wig.js\"],\"default\"]\n4:[\"$\",\"$L1c\",null,{\"formats\":\"$undefined\",\"locale\":\"ar\",\"messages\":{\"about\":\"من نحن\",\"about_app\":\"عن التطبيق\",\"about_app2\":\"من اهم مميزات البرنامج :\",\"about_body\":\"نحن مكتبة متخصصة في تطوير وصناعة التطبيقات ذات الطابع الإسلامي والتعليمي. نهدف إلى تقديم حلول رقمية موثوقة وسهلة الاستخدام تساعد المسلمين على القراءة والتعلم والالتزام بذكر الله من خلال تجارب تقنية جميلة ومتقنة. نركز على الأداء العالي، قابلية الوصول، ودعم منصات متعددة لضمان وصول الفائدة لأكبر عدد من المستخدمين.\",\"about_contact_cta\":\"يسعدنا تواصلك معنا — اكتب لنا أدناه:\",\"about_eyebrow\":\"من نحن\",\"about_hadith_ref\":\"رواه مسلم\",\"about_hadith_text\":\"«مَن سَلَكَ طَريقًا يَلْتَمِسُ فيه عِلْمًا سَهَّلَ اللهُ لَهُ به طَريقًا إلى الجَنَّة»\",\"about_head\":\"مكتبة الحكمة\",\"about_p1\":\"مكتبة الحكمة منصة إسلامية شاملة، وُلدت من شغفٍ بخدمة كتاب الله وسنة نبيه ﷺ. نؤمن بأن العلم النافع أمانةٌ يجب أن تصل لكل بيتٍ بأسهل الطرق وأجملها.\",\"about_p2\":\"نجمع بين أصالة المحتوى وجمال التجربة، لنقدّم لك القرآن بصوتياته ومرتليه، والأذكار، والكتب المختارة — في واجهةٍ واحدةٍ متناغمة.\",\"about_page_eyebrow\":\"من نحن\",\"about_page_lede\":\"منصة إسلامية شاملة لنشر العلم النافع.\",\"about_page_story_1\":\"وُلدت مكتبة الحكمة من شغفٍ بخدمة كتاب الله وسنة نبيه ﷺ. نؤمن بأن العلم النافع أمانةٌ يجب أن تصل لكل بيتٍ بأسهل الطرق وأجملها.\",\"about_page_story_2\":\"نجمع بين أصالة المحتوى وجمال التجربة، لنقدّم لك القرآن بصوتياته ومرتليه، والأذكار، والكتب المختارة — في واجهةٍ واحدةٍ متناغمة.\",\"about_page_story_3\":\"نركز على الأداء العالي، قابلية الوصول، ودعم منصات متعددة لضمان وصول الفائدة لأكبر عدد من المستخدمين.\",\"about_page_title\":\"مكتبة الحكمة\",\"about_stat_1\":\"تحميل\",\"about_stat_2\":\"لغات مدعومة\",\"about_stat_3\":\"تطبيقات\",\"about_stat_4\":\"مجاني\",\"about_title\":\"من نحن\",\"about_title_1\":\"رسالةٌ من\",\"about_title_2\":\"العلم النافع\",\"about_us\":\"عن التطبيق\",\"about_value_1_desc\":\"نهتم بأدق التفاصيل لنقدّم تجربة استخدام متقنة.\",\"about_value_1_title\":\"الجودة\",\"about_value_2_desc\":\"محتوى موثوق من مصادر معتمدة وعلماء موثوقين.\",\"about_value_2_title\":\"الأصالة\",\"about_value_3_desc\":\"نضع احتياجات المستخدم أولًا في كل ما نصمّم.\",\"about_value_3_title\":\"الخدمة\",\"about_value_4_desc\":\"مفتوحون للمطورين عبر API ومكتبات مفتوحة المصدر.\",\"about_value_4_title\":\"الانفتاح\",\"about_values_title\":\"قيمنا\",\"about_vision_text\":\"أن نكون المنصة الإسلامية الأولى عربيًا وعالميًا في نشر العلم النافع عبر تجربة استخدامٍ راقية ومحتوى موثوق.\",\"about_vision_title\":\"رؤيتنا\",\"aboutAzkaryApp3\":\"◉ يتيح لك هذا التطبيق القابلية لحفظ الأذكار المفضلة لديك في قائمة خاصة، مما يجعلها سهلة الوصول والاستعراض في أي وقت.\\n◉ بإمكانك التحكم بحجم الخط وتكبيره أو تصغيره حسب رغبتك للقراءة الأكثر راحة.\\n◉ كما يقدم التطبيق ثلاثة أنماط لواجهة المستخدم - الأخضر، الأزرق، والداكن - مما يعطيك القدرة لتخصيص شكل التطبيق وفقا لتفضيلاتك.\\n◉ ما يميز \\\"أذكاري من الكتاب والسنة\\\" أيضا، هو إمكانية مشاركة الأذكار بسهولة مع الأصدقاء والعائلة.\\n◉ يمكنك المشاركة بالنص مباشرة أو بإرسال صورة تحتوي على الذكر، مما يجعل تجربة التواصل والتفاعل مع الآخرين أكثر غنى وعمقا.\\n◉ يمكنك تحديد الأوقات التي تفضل فيها قراءة الأذكار، وسوف يقوم التطبيق بتذكيرك في تلك الأوقات بدقة.\",\"aboutBook\":\"عن الكتاب\",\"aboutBooks\":\"عن الكتاب\",\"aboutQuranApp3\":\"◉ يُمَكِنُكَ هذا التطبيق من قراءة القرآن كما لو كنت تقرأ في المصحف، ويمكنك القراءة بالوضع العامودي والأفقي.\\n◉ كما يُمْكِنُكَ القراءة بالوضع المتغير الذي يمكنك من تكبير وتصغير كما تريد.\\n◉ يحتوي التطبيق على خاصية البحث النصي في آيات القرآن من خلال البحث اللحظي وعرض النتائج مع الصفحات بالإضافة إلى إمكانية الذهاب للصفحة\\n◉ إضافة فواصل للقراءة بحيث يتمكن القارئ من حفظ الصفحة والعودة لها متى شاء.\\n◉ إضافة ملاحظات.\\n◉ الاستماع لكل آية بصوت عدد من القراء.\\n◉ يتيح التطبيق التفسير لكل آية، كما يُمْكِنُكَ التغيير بين التفاسير كما يُمْكِنُكَ تغيير حجم خط التفسير.\\n◉ فهرس للسور.\\n◉ التنقل بين السّور بسهولة.\\n◉ يتيح التطبيق قراءة علامات الوقف.\\n◉ يُمْكِنُكَ التطبيق من قراءة حصن المسلم كاملًا ومقسم بحسب الأذكار بحيث يسهل على القارئ التنقل بين الأقسام، كما يُمْكِنُكَ إضافة أي ذكر إلى المفضلة.\\n◉ يتيح التطبيق للقارئ القراءة تغيير أنماط الألوان ومنها النمط الداكن والذي يغير لون الخلفية باللون الأسود والخطوط البيضاء لتعطي القارئ الراحة التامة عند القراءة في أجواء منخفضة الإضاءة.\",\"aboutSurah\":\"عن السورة\",\"action_browse\":\"تصفح\",\"action_listen\":\"استمع\",\"action_read\":\"اقرأ\",\"action_review\":\"راجع\",\"allBooks\":\"كل الكتب\",\"app_hisn_desc\":\"الأذكار والأدعية من الكتاب والسنة، بتنسيقٍ عمليٍّ ويوميٍّ يساعدك على المداومة.\",\"app_hisn_title\":\"حصن المسلم\",\"app_not_found\":\"تعذّر العثور على التطبيق المطلوب.\",\"app_qalaid_desc\":\"مكتبةٌ رقمية للكتب الإسلامية والعلم النافع، منتقاةٌ لتكون بين يديك في أي وقت.\",\"app_qalaid_title\":\"القلائد\",\"app_quran_desc\":\"تطبيقٌ متكامل لقراءة القرآن الكريم بصوتياته ومرتليه، مع التفسير والترجمة لكل آية.\",\"app_quran_title\":\"القرآن الكريم\",\"appGallery\":\"للتحميل من متجر |App Gallery|\",\"appLang\":\"لغة التطبيق\",\"appName\":\"مكتبة الحكمة\",\"apps\":\"تطبيقاتنا\",\"apps_error\":\"تعذّر تحميل التطبيقات. حاول لاحقًا.\",\"apps_eyebrow\":\"تطبيقاتنا\",\"apps_lede\":\"تطبيقاتٌ مصممة بعنايةٍ لتواكب حياتك اليومية وتكون رفيقك في الطريق إلى الله.\",\"apps_loading\":\"جارٍ تحميل التطبيقات...\",\"apps_page_eyebrow\":\"تطبيقاتنا\",\"apps_page_lede\":\"تطبيقات إسلامية مصممة بعناية لمواكبة حياتك اليومية.\",\"apps_page_title\":\"عائلة التطبيقات\",\"apps_title_1\":\"من عائلة\",\"apps_title_2\":\"الحكمة\",\"apps_view_details\":\"عرض التفاصيل\",\"appStoreD\":\"للتحميل من متجر |App Store| لسطح المكتب\",\"appStoreI\":\"للتحميل من متجر |App Store|\",\"athkar\":\"الأذكار\",\"athkar_copied\":\"تم النسخ\",\"athkar_copy\":\"نسخ\",\"athkar_count_label\":\"التكرار\",\"athkar_done\":\"تم بحمد الله\",\"athkar_empty\":\"لا توجد أذكار في هذه الفئة.\",\"athkar_eyebrow\":\"حصن المسلم\",\"athkar_lede\":\"أذكار الصباح والمساء وأدعية من الكتاب والسنة.\",\"athkar_of\":\"من\",\"athkar_reset\":\"إعادة\",\"athkar_search_category\":\"ابحث عن فئة...\",\"athkar_tap_count\":\"اضغط للعدّ\",\"athkar_title\":\"الأذكار والأدعية\",\"aya_count\":\"عدد الايآت\",\"ayah\":\"آية\",\"ayah_band_ref\":\"سورة الإسراء · آية ٨٢\",\"ayah_band_text\":\"وَنُنَزِّلُ مِنَ الْقُرْآنِ مَا هُوَ شِفَاءٌ وَرَحْمَةٌ لِّلْمُؤْمِنِينَ\",\"ayah_copied\":\"تم نسخ الآية\",\"ayahs\":\"آيات\",\"azkar\":\"الأذكار\",\"book_back\":\"رجوع\",\"book_back_to_library\":\"العودة للمكتبة\",\"book_error\":\"تعذّر تحميل الصفحة.\",\"book_loading\":\"جارٍ تحميل الصفحة...\",\"book_next\":\"التالية\",\"book_of\":\"من\",\"book_page\":\"صفحة\",\"book_prev\":\"السابقة\",\"book_retry\":\"إعادة المحاولة\",\"book_toc\":\"الفهرس\",\"book_toc_empty\":\"لا يوجد فهرس لهذا الكتاب.\",\"book_unavailable_desc\":\"لم نتمكن من تحميل محتوى هذا الكتاب. قد يكون الملف غير متاح مؤقتًا.\",\"book_unavailable_title\":\"تعذّر تحميل الكتاب\",\"bookJuz\":\"أجزاء الكتاب\",\"bookmarks\":\"الفواصل\",\"bookRemovedFromLastRead\":\"تم حذف الكتاب من آخر قراءة\",\"books\":\"المكتبة\",\"books_empty\":\"لا توجد كتب مطابقة لبحثك.\",\"books_eyebrow\":\"المكتبة الإسلامية\",\"books_featured\":\"مميز\",\"books_lede\":\"مكتبة شاملة من كتب التفسير والحديث والفقه والعقيدة والسيرة وغيرها من علوم الشريعة.\",\"books_pages\":\"صفحة\",\"books_search_placeholder\":\"ابحث عن كتاب أو مؤلف...\",\"books_six_books\":\"الكتب الستة\",\"books_tab_all\":\"الكل\",\"books_tab_hadiths\":\"الحديث\",\"books_tab_tafsir\":\"التفسير\",\"books_title\":\"المكتبة الإسلامية\",\"books_type_hadiths\":\"حديث\",\"books_type_tafsir\":\"تفسير\",\"brown\":\"النمط البني\",\"changeTheme\":\"تغيير النمط\",\"chapter\":\"الفصل\",\"chapterBook\":\"فصول الكتاب\",\"contact_email\":\"البريد الإلك