tic/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\"],\"default\"]\ne:I[92370,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/1kmzfrn9ymvcu.js\",\"/_next/static/chunks/3qssvey5t78f1.js\",\"/_next/static/chunks/25lxdbndxci5v.js\",\"/_next/static/chunks/1ijqylqiu6wig.js\",\"/_next/static/chunks/23l0dfuxbi9-u.js\"],\"default\"]\nf:I[76910,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/1kmzfrn9ymvcu.js\",\"/_next/static/chunks/3qssvey5t78f1.js\",\"/_next/static/chunks/25lxdbndxci5v.js\",\"/_next/static/chunks/1ijqylqiu6wig.js\"],\"SiteFooter\"]\n3:Tc7c,◉ এই অ্যাপ্লিকেশনটি আপনাকে কুরআন পড়তে সক্ষম করে যেন আপনি মুসহাফে পড়ছেন, এবং আপনি উল্লম্ব এবং অনুভূমিক মোডে পড়তে পারেন।\n◉ এছাড়াও আপনি পরিবর্তনীয় মোডে পড়তে পারেন যা আপনাকে ইচ্ছামতো জুম ইন এবং জুম আউট করতে সক্ষম করে।\n◉ অ্যাপ্লিকেশনে তাৎক্ষণিক অনুসন্ধান এবং পৃষ্ঠাগুলির সাথে ফলাফল প্রদর্শনের মাধ্যমে কুরআনের আয়াতগুলিতে পাঠ্য অনুসন্ধানের বৈশিষ্ট্য রয়েছে এবং প্রয়োজনে পৃষ্ঠায় যাওয়ার সম্ভাবনা রয়েছে।\n◉ পড়ার জন্য বুকমার্ক যোগ করা যাতে পাঠক পৃষ্ঠা সংরক্ষণ করতে এবং যখনই চান তাতে ফিরতে পারেন।\n◉ নোট যোগ করা।\n◉ বিভিন্ন কারীর কণ্ঠে প্রতিটি আয়াত শোনার ক্ষমতা।\n◉ অ্যাপ প্রতিটি আয়াতের জন্য তাফসীর সরবরাহ করে, আপনি তাফসীরের মধ্যে পরিবর্তন করতে পারেন এবং তাফসীরের ফন্টের আকার পরিবর্তন করতে পারেন।\n◉ সূরার সূচী।\n◉ সূরাগুলির মধ্যে সহজে নেভিগেট করা।\n◉ অ্যাপ আপনাকে বিরতি চিহ্নের অর্থ পড়তে দেয়।\n◉ অ্যাপ্লিকেশনটি আপনাকে হিসনুল মুসলিম সম্পূর্ণ পড়তে এবং যিকির অনুযায়ী বিভক্ত করতে সক্ষম করে যাতে পাঠকের পক্ষে বিভাগগুলির মধ্যে নেভিগেট করা সহজ হয় এবং আপনি যেকোনো যিকির পছন্দের তালিকায় যোগ করতে পারেন।\n◉ অ্যাপ্লিকেশনটি পাঠককে রঙের প্যাটার্ন পরিবর্তন করার অনুমতি দেয়, যার মধ্যে ডার্ক প্যাটার্ন রয়েছে যা পটভূমির রঙ কালো এবং সাদা লাইনে পরিবর্তন করে কম আলোর পরিবেশে পড়ার সময় পাঠককে সম্পূর্ণ আরাম দিতে।0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/1kmzfrn9ymvcu.js\",\"async\":true}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/3qssvey5t78f1.js\",\"async\":true}],[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/chunks/25lxdbndxci5v.js\",\"async\":true}],[\"$\",\"script\",\"script-3\",{\"src\":\"/_next/static/chunks/1ijqylqiu6wig.js\",\"async\":true}]],[\"$\",\"$L2\",null,{\"locale\":\"be\",\"messages\":{\"about\":\"About\",\"about_app\":\"অ্যাপ সম্পর্কে\",\"about_app2\":\"প্রোগ্রামের সবচেয়ে গুরুত্বপূর্ণ বৈশিষ্ট্যগুলি:\",\"about_body\":\"আমরা একটি লাইব্রেরি যা ইসলামিক এবং শিক্ষামূলক চরিত্রের অ্যাপ্লিকেশন উন্নয়ন ও নির্মাণে বিশেষায়িত। আমাদের লক্ষ্য হল নির্ভরযোগ্য এবং ব্যবহার-বান্ধব ডিজিটাল সমাধান প্রদান করা যা মুসলমানদের সুন্দর এবং পরিমার্জিত প্রযুক্তিগত অভিজ্ঞতার মাধ্যমে পড়তে, শিখতে এবং আল্লাহর স্মরণে প্রতিশ্রুতিবদ্ধ থাকতে সাহায্য করে। আমরা উচ্চ কর্মক্ষমতা, অ্যাক্সেসিবিলিটি এবং বহু-প্ল্যাটফর্ম সমর্থনের উপর ফোকাস করি যাতে সর্বাধিক সংখ্যক ব্যবহারকারীর কাছে সুবিধা পৌঁছানো যায়।\",\"about_contact_cta\":\"আপনার সাথে কথা বলতে আমরা খুশি — নিচে আমাদের লিখুন:\",\"about_eyebrow\":\"About Us\",\"about_hadith_ref\":\"Narrated by Muslim\",\"about_hadith_text\":\"“Whoever follows a path seeking knowledge, Allah will make easy for him a path to Paradise”\",\"about_head\":\"আল হিকমাহ লাইব্রেরি\",\"about_p1\":\"Alheekmah Library is a comprehensive Islamic platform, born from a passion to serve the Book of Allah and the Sunnah of His Prophet ﷺ. We believe that beneficial knowledge is a trust that must reach every home through the easiest and most beautiful means.\",\"about_p2\":\"We combine the authenticity of content with the beauty of experience, to bring you the Quran with its recitations, Adhkar, and selected books — in one harmonious interface.\",\"about_page_eyebrow\":\"About Us\",\"about_page_lede\":\"A comprehensive Islamic platform for spreading beneficial knowledge.\",\"about_page_story_1\":\"Alheekmah Library was born from a passion to serve the Book of Allah and the Sunnah of His Prophet ﷺ. We believe beneficial knowledge is a trust that must reach every home through the easiest and most beautiful means.\",\"about_page_story_2\":\"We combine content authenticity with experience beauty, to bring you the Quran with its recitations, Adhkar, and selected books — in one harmonious interface.\",\"about_page_story_3\":\"We focus on high performance, accessibility, and multi-platform support to ensure the benefit reaches the maximum number of users.\",\"about_page_title\":\"Alheekmah Library\",\"about_stat_1\":\"Downloads\",\"about_stat_2\":\"Languages\",\"about_stat_3\":\"Apps\",\"about_stat_4\":\"Free\",\"about_title\":\"আমরা কারা\",\"about_title_1\":\"A message of\",\"about_title_2\":\"beneficial knowledge\",\"about_us\":\"অ্যাপ সম্পর্কে\",\"about_value_1_desc\":\"We care about the finest details to deliver a refined experience.\",\"about_value_1_title\":\"Quality\",\"about_value_2_desc\":\"Trusted content from approved sources and reliable scholars.\",\"about_value_2_title\":\"Authenticity\",\"about_value_3_desc\":\"We put user needs first in everything we design.\",\"about_value_3_title\":\"Service\",\"about_value_4_desc\":\"Open to developers via API and open-source libraries.\",\"about_value_4_title\":\"Openness\",\"about_values_title\":\"Our Values\",\"about_vision_text\":\"To be the leading Islamic platform, in Arabic and internationally, in spreading beneficial knowledge through refined user experience and trusted content.\",\"about_vision_title\":\"Our Vision\",\"aboutAzkaryApp3\":\"◉ এই অ্যাপ্লিকেশনটি আপনাকে আপনার পছন্দের যিকিরগুলি একটি বিশেষ তালিকায় সংরক্ষণ করার সুবিধা দেয়, যা তাদের যেকোনো সময় সহজে অ্যাক্সেসযোগ্য এবং পর্যালোচনাযোগ্য করে তোলে।\\n◉ আপনি ফন্টের আকার নিয়ন্ত্রণ করতে পারেন এবং আরও আরামদায়ক পড়ার জন্য আপনার পছন্দ অনুযায়ী এটি বড় বা ছোট করতে পারেন।\\n◉ অ্যাপ্লিকেশনটি ব্যবহারকারী ইন্টারফেসের জন্য তিনটি মোড সরবরাহ করে - সবুজ, নীল এবং অন্ধকার - যা আপনাকে আপনার পছন্দ অনুযায়ী অ্যাপের চেহারা কাস্টমাইজ করার ক্ষমতা দেয়।\\n◉ \\\"কিতাব ও সুন্নাহ থেকে আমার যিকির\\\" এর বিশেষত্ব হল বন্ধু এবং পরিবারের সাথে সহজে যিকির ভাগ করার ক্ষমতা।\\n◉ আপনি সরাসরি পাঠ্যে ভাগ করতে পারেন বা যিকির সম্বলিত ছবি পাঠিয়ে ভাগ করতে পারেন, যা অন্যদের সাথে যোগাযোগ এবং মিথস্ক্রিয়ার অভিজ্ঞতাকে আরও সমৃদ্ধ এবং গভীর করে তোলে।\\n◉ আপনি যিকির পড়ার জন্য আপনার পছন্দের সময় নির্ধারণ করতে পারেন, এবং অ্যাপ্লিকেশনটি সেই সময়গুলিতে আপনাকে সঠিকভাবে মনে করিয়ে দেবে।\",\"aboutBook\":\"বই সম্পর্কে\",\"aboutBooks\":\"বই সম্পর্কে\",\"aboutQuranApp3\":\"$3\",\"aboutSurah\":\"সূরা সম্পর্কে\",\"action_browse\":\"Browse\",\"action_listen\":\"Listen\",\"action_read\":\"Read\",\"action_review\":\"Review\",\"allBooks\":\"সকল বই\",\"app_hisn_desc\":\"Adhkar and supplications from the Quran and Sunnah, in a practical daily format that helps you persist.\",\"app_hisn_title\":\"Hisnul Muslim\",\"app_not_found\":\"অনুরোধকৃত অ্যাপ খুঁজে পাওয়া যায়নি।\",\"app_qalaid_desc\":\"A digital library of selected Islamic books and beneficial knowledge, at your fingertips anytime.\",\"app_qalaid_title\":\"Al-Qalaid\",\"app_quran_desc\":\"A comprehensive app for reading the Holy Quran with recitations, tafsir, and translation for every verse.\",\"app_quran_title\":\"Holy Quran\",\"appGallery\":\"|অ্যাপ গ্যালারি| থেকে ডাউনলোড করুন\",\"appLang\":\"অ্যাপের ভাষা\",\"appName\":\"আল হিকমাহ লাইব্রেরি\",\"apps\":\"Our Apps\",\"apps_error\":\"Failed to load apps. Try again later.\",\"apps_eyebrow\":\"Our Apps\",\"apps_lede\":\"Apps carefully designed to accompany your daily life and be your companion on the path to Allah.\",\"apps_loading\":\"Loading apps...\",\"apps_page_eyebrow\":\"Our Apps\",\"apps_page_lede\":\"Islamic apps carefully designed to accompany your daily life.\",\"apps_page_title\":\"Apps Family\",\"apps_title_1\":\"From the\",\"apps_title_2\":\"Alheekmah\",\"apps_view_details\":\"View details\",\"appStoreD\":\"ডেস্কটপের জন্য |অ্যাপ স্টোর| থেকে ডাউনলোড করুন\",\"appStoreI\":\"|অ্যাপ স্টোর| থেকে ডাউনলোড করুন\",\"athkar\":\"আযকার\",\"athkar_copied\":\"Copied\",\"athkar_copy\":\"Copy\",\"athkar_count_label\":\"Repeat\",\"athkar_done\":\"Done, alhamdulillah\",\"athkar_empty\":\"No adhkar in this category.\",\"athkar_eyebrow\":\"Hisnul Muslim\",\"athkar_lede\":\"Morning and evening adhkar and supplications from Quran and Sunnah.\",\"athkar_of\":\"of\",\"athkar_reset\":\"Reset\",\"athkar_search_category\":\"Search category...\",\"athkar_tap_count\":\"Tap to count\",\"athkar_title\":\"Adhkar & Supplications\",\"aya_count\":\"আয়াত সংখ্যা\",\"ayah\":\"আয়াত\",\"ayah_band_ref\":\"Surah Al-Isra · Verse 82\",\"ayah_band_text\":\"And We send down of the Quran that which is a healing and a mercy for the believers\",\"ayah_copied\":\"আয়াত কপি হয়েছে\",\"ayahs\":\"আয়াতসমূহ\",\"azkar\":\"আযকার\",\"book_back\":\"Back\",\"book_back_to_library\":\"Back to Library\",\"book_error\":\"Failed to load page.\",\"book_loading\":\"Loading page...\",\"book_next\":\"Next\",\"book_of\":\"of\",\"book_page\":\"Page\",\"book_prev\":\"Previous\",\"book_retry\":\"Retry\",\"book_toc\":\"Index\",\"book_toc_empty\":\"No index for this book.\",\"book_unavailable_desc\":\"We could not load this book content. The file may be temporarily unavailable.\",\"book_unavailable_title\":\"Failed to Load Book\",\"bookJuz\":\"বইয়ের অংশসমূহ\",\"bookmarks\":\"বুকমার্ক\",\"bookRemovedFromLastRead\":\"বইটি শেষ পঠিত থেকে সরানো হয়েছে\",\"books\":\"Library\",\"books_empty\":\"No books match your search.\",\"books_eyebrow\":\"Islamic Library\",\"books_featured\":\"Featured\",\"books_lede\":\"A comprehensive library of tafsir, hadith, fiqh, aqeedah, seerah and other Islamic sciences.\",\"books_pages\":\"pages\",\"books_search_placeholder\":\"Search books or authors...\",\"books_six_books\":\"The Six Books\",\"books_tab_all\":\"All\",\"books_tab_hadiths\":\"Hadith\",\"books_tab_tafsir\":\"Tafsir\",\"books_title\":\"Islamic Library\",\"books_type_hadiths\":\"Hadith\",\"books_type_tafsir\":\"Tafsir\",\"brown\":\"বাদামী মোড\",\"changeTheme\":\"থিম পরিবর্তন\",\"chapter\":\"অধ্যায়\",\"chapterBook\":\"বইয়ের অধ্যায়সমূহ\",\"contact_email\":\"ইমেইল ঠিকানা\",\"contact_email_label\":\"Email\",\"contact_email_ph\":\"example@email.com\",\"contact_error\":\"বার্তা পাঠাতে ব্যর্থ। পরে চেষ্টা করুন।\",\"contact_head\":\"আপনার পরবর্তী প্রকল্প শুরু করি\",\"contact_info_desc\":\"We value your feedback and suggestions to improve our services.\",\"contact_info_title\":\"Contact Information\",\"contact_message\":\"আপনার বার্তা\",\"contact_message_ph\":\"Write your message here...\",\"contact_name\":\"পূর্ণ নাম\",\"contact_name_ph\":\"Enter your full name\",\"contact_page_eyebrow\":\"Contact Us\",\"contact_page_lede\":\"Send us your message and we will reply as soon as possible.\",\"contact_page_title\":\"We Are Here to Listen\",\"contact_quote\":\"“And who is better in speech than one who invites to Allah”\",\"contact_subject\":\"বিষয়\",\"contact_subject_ph\":\"Message subject\",\"contact_success\":\"আপনার বার্তা সফলভাবে পাঠানো হয়েছে।\",\"contact_title\":\"যোগাযোগ\",\"copyAyah\":\"আয়াত কপি হয়েছে\",\"copyAzkarText\":\"যিকির কপি হয়েছে\",\"CreateAnAPIKey\":\"API কী তৈরি করুন\",\"cta_athkar\":\"আযকার\",\"cta_books\":\"কেতাবসমূহ\",\"cta_our_apps\":\"আমাদের অ্যাপ\",\"cta_quran\":\"আল কুরআন\",\"cta_start_project\":\"আপনার প্রকল্প শুরু করুন\",\"cta_start_reading\":\"Start Reading\",\"dark\":\"ডার্ক মোড\",\"delete\":\"মুছুন\",\"detecting_platform\":\"স্বয়ংক্রিয় রিডাইরেকশনের জন্য আপনার প্ল্যাটফর্ম সনাক্ত করা হচ্ছে...\",\"developers_api\":\"API\",\"developers_base_url\":\"Base URL:\",\"developers_dashboard\":\"Developers Dashboard\",\"developers_dashboard_hint\":\"Upload or paste the JSON to review data and export the final file.\",\"developers_docs\":\"Documentation\",\"developers_download\":\"Download\",\"developers_empty\":\"No data available.\",\"developers_endpoints\":\"Endpoints\",\"developers_export_done\":\"File exported.\",\"developers_export_json\":\"Export JSON\",\"developers_github\":\"GitHub\",\"developers_items_count\":\"Items:\",\"developers_json_empty\":\"File is empty.\",\"developers_json_hint\":\"Paste developers.json content here...\",\"developers_json_invalid\":\"Invalid JSON file.\",\"developers_json_valid\":\"JSON is valid.\",\"developers_libraries\":\"Libraries\",\"developers_library\":\"Library\",\"developers_open\":\"Open\",\"developers_open_dashboard\":\"Open Dashboard\",\"developers_page_eyebrow\":\"Developers\",\"developers_page_lede\":\"Libraries, APIs, and downloads to help you build your apps.\",\"developers_page_title\":\"Built for Developers\",\"developers_preview\":\"Sections Preview\",\"developers_preview_empty\":\"No preview yet.\",\"developers_readme\":\"Library README\",\"developers_readme_error\":\"Failed to load README.\",\"developers_readme_url\":\"README URL\",\"developers_sections_count\":\"Sections:\",\"developers_title\":\"Developers\",\"developers_updated\":\"Last update:\",\"developers_upload_json\":\"Upload JSON\",\"developers_validate_json\":\"Validate\",\"developers_version\":\"Version:\",\"developers_view_docs\":\"View full documentation\",\"download_page_title\":\"অ্যাপ ডাউনলোড\",\"downloads\":\"Downloads\",\"dwaaDaily\":\"আজকের দোয়া\",\"Email\":\"ইমেইল\",\"Error\":\"ত্রুটি\",\"errorLoadingData\":\"ডেটা লোড করতে ত্রুটি\",\"faq\":\"FAQ\",\"faq_a1\":\"উপরের বারে থিম আইকন থেকে।\",\"faq_a10\":\"আমরা আপনার ডেটার গোপনীয়তা রক্ষা করি এবং তৃতীয় পক্ষের সাথে শেয়ার করি না, এবং বিশ্বস্ত অবকাঠামো ব্যবহার করি।\",\"faq_a11\":\"ব্যাংক ট্রান্সফার এবং দেশ অনুযায়ী সাধারণ ইলেকট্রনিক পেমেন্ট গেটওয়ে।\",\"faq_a12\":\"ওয়েবসাইটের \\\"যোগাযোগ\\\" ট্যাব থেকে, আপনার বার্তা মেইল অ্যাপ না খুলেই সরাসরি আমাদের টিমের কাছে পৌঁছায়।\",\"faq_a2\":\"কিছু বিভাগ প্রাথমিক লোডের পরে ইন্টারনেট ছাড়াই কাজ করে।\",\"faq_a3\":\"অনুসন্ধান বক্স থেকে অথবা কুরআন ট্যাব থেকে।\",\"faq_a4\":\"হ্যাঁ, ইন্টারফেস সব আকারের জন্য প্রতিক্রিয়াশীল।\",\"faq_a5\":\"\\\"আপনার প্রকল্প শুরু করুন\\\" বোতামের মাধ্যমে আমাদের একটি সারসংক্ষেপ পাঠান এবং আমরা ২৪-৪৮ ঘন্টার মধ্যে স্পষ্ট পদক্ষেপ সহ আপনার কাছে ফিরে আসব।\",\"faq_a6\":\"আমরা একটি কোডবেস থেকে iOS, Android এবং ওয়েবকে লক্ষ্য করি প্রতিটি প্ল্যাটফর্মের জন্য অপ্টিমাইজেশন সহ।\",\"faq_a7\":\"এটি প্রকল্পের আকার এবং পরিসরের উপর নির্ভর করে; সাধারণত ছোট এবং মাঝারি প্রকল্পের জন্য ২ থেকে ৮ সপ্তাহ।\",\"faq_a8\":\"পরিসর এবং প্রয়োজনীয় বৈশিষ্ট্যের ভিত্তিতে। প্রয়োজনীয়তা বোঝার পর আমরা বিস্তারিত মূল্য প্রস্তাব পাঠাই।\",\"faq_a9\":\"হ্যাঁ, আমরা আপডেট, উন্নতি এবং বাগ ফিক্সের জন্য মাসিক রক্ষণাবেক্ষণ পরিকল্পনা বা অনুরোধের ভিত্তিতে সেবা প্রদান করি।\",\"faq_api_a\":\"Yes, we provide the open-source quran_library, and an API for the Quran dataset. Developers can explore them from the \\\"Developers\\\" section.\",\"faq_api_q\":\"Do you offer an API for developers?\",\"faq_apps_a\":\"Yes, all our apps are available on the Apple App Store, Google Play, and Huawei AppGallery. You can browse them from the \\\"Our Apps\\\" section.\",\"faq_apps_q\":\"Are the apps available on iOS and Android?\",\"faq_contact_a\":\"You can contact us via the \\\"Contact Us\\\" page, and we are happy to hear your feedback and suggestions to improve our services.\",\"faq_contact_q\":\"How can I contact you?\",\"faq_data_a\":\"We source our data from trusted and approved sources, and provide part of it to developers via an open API.\",\"faq_data_q\":\"Where does your data come from?\",\"faq_eyebrow\":\"FAQ\",\"faq_free_a\":\"Yes, all Alheekmah Library services are completely free and free of annoying ads. We aim to spread beneficial knowledge without any financial obstacles, as a dedication for the sake of Allah.\",\"faq_free_q\":\"Is Alheekmah Library completely free to use?\",\"faq_lede\":\"Everything you want to know about Alheekmah Library and its services.\",\"faq_offline_a\":\"Our mobile apps work offline after the initial download. The website requires a connection.\",\"faq_offline_q\":\"Can I use the apps offline?\",\"faq_page_eyebrow\":\"FAQ\",\"faq_page_lede\":\"Answers to the most common questions about Alheekmah Library.\",\"faq_page_title\":\"Everything You Need to Know\",\"faq_q1\":\"কীভাবে হালকা এবং অন্ধকার থিমের মধ্যে পরিবর্তন করব?\",\"faq_q10\":\"ডেটা গোপনীয়তা সম্পর্কে কী?\",\"faq_q11\":\"কোন পেমেন্ট পদ্ধতি উপলব্ধ?\",\"faq_q12\":\"আমি কীভাবে আপনাদের সাথে সরাসরি যোগাযোগ করব?\",\"faq_q2\":\"এটি কি ইন্টারনেট ছাড়া কাজ করে?\",\"faq_q3\":\"কুরআনের ভিতরে কীভাবে অনুসন্ধান করব?\",\"faq_q4\":\"ফোন এবং কম্পিউটারের জন্য কি মোড আছে?\",\"faq_q5\":\"আমি কীভাবে আপনার সাথে একটি অ্যাপ প্রকল্প শুরু করব?\",\"faq_q6\":\"আপনারা কোন প্ল্যাটফর্ম সাপোর্ট করেন?\",\"faq_q7\":\"অ্যাপ্লিকেশন ডেভেলপমেন্ট কতক্ষণ সময় নেয়?\",\"faq_q8\":\"মূল্য নির্ধারণ কীভাবে হয়?\",\"faq_q9\":\"আপনারা কি রক্ষণাবেক্ষণ এবং আপডেট প্রদান করেন?\",\"faq_tafsir_a\":\"Yes, we provide multiple tafsirs (Ibn Kathir, Al-Muyassar, Al-Saadi...) and translations in more than 10 languages, with the ability to switch between them easily while reading.\",\"faq_tafsir_q\":\"Is tafsir and translation available for the Holy Quran?\",\"faq_title\":\"সাধারণ প্রশ্ন\",\"faq_title_1\":\"Answers to your\",\"faq_title_2\":\"questions\",\"feature_clean_title\":\"Ad-free experience\",\"feature_multilang_title\":\"Multilingual\",\"feature_opensource_title\":\"Open for developers\",\"feature_trusted_title\":\"Trusted content\",\"footer_desc\":\"A comprehensive Islamic platform for spreading beneficial knowledge and serving the Book of Allah and the Sunnah of His Prophet ﷺ, through trusted content and a refined user experience.\",\"footer_made_with\":\"Crafted with care to serve the Book of Allah\",\"footnotes\":\"ফুটনোট\",\"goToStartOfJuz\":\"অংশের শুরুতে যান\",\"greenBookmarks\":\"সবুজ বুকমার্ক\",\"hadiths\":\"হাদিস\",\"hero_ayah_ref\":\"Surah Ar-Ra'd · 28\",\"hero_ayah_text\":\"“Verily, in the remembrance of Allah do hearts find rest”\",\"hero_badge\":\"Comprehensive Islamic Platform\",\"hero_subtitle\":\"আমরা আপনার ধারণাকে একটি পরিমার্জিত ডিজিটাল অভিজ্ঞতায় রূপান্তরিত করি যা iOS, Android, Web এবং Desktop-এ মসৃণভাবে কাজ করে, উচ্চ মান ও পারফরম্যান্সসহ।\",\"hero_title\":\"আমরা মোবাইল, ওয়েব এবং ডেস্কটপের জন্য পেশাদার অ্যাপ তৈরি করি\",\"hero_title_1\":\"Where the\",\"hero_title_2\":\"Quran\",\"hero_title_3\":\"is recited and wisdom is written\",\"hizb\":\"হিযব\",\"home\":\"হোম\",\"index\":\"সূচি\",\"invalid_email\":\"ইমেইল ঠিকানা বৈধ নয়\",\"juz\":\"জুজ়\",\"juzz\":\"পারাসমূহ\",\"last_listen\":\"সর্বশেষ শোনা\",\"lastRead\":\"সর্বশেষ পড়া\",\"myLibrary\":\"আমার লাইব্রেরি\",\"ninthBooks\":\"নবম বইসমূহ\",\"no_bookmarks_yet\":\"এখনো কোনো বুকমার্ক নেই\",\"noBooksDownloaded\":\"এখনো কোনো বই ডাউনলোড হয়নি\",\"noBooksFoundForSearch\":\"এই অনুসন্ধানের জন্য কোনো বই পাওয়া যায়নি।\",\"noBooksReadedYet\":\"এখনো কোনো বই পড়া হয়নি\",\"noChaptersInThisJuz\":\"এই অংশে কোনো অধ্যায় নেই\",\"noPagesFound\":\"এই বইয়ের জন্য কোনো পৃষ্ঠা পাওয়া যায়নি।\",\"not_found_ayah\":\"“And whoever fears Allah — He will make for him a way out and will provide for him from where he does not expect”\",\"not_found_ayah_ref\":\"Surah At-Talaq · 2-3\",\"not_found_desc\":\"Sorry, the page you are looking for does not exist or has been moved. You might find what you are looking for in the links below.\",\"not_found_home\":\"Back to Home\",\"not_found_title\":\"Page Not Found\",\"open_store_button\":\"এখনই স্টোর খুলুন\",\"ourApps\":\"আমাদের অ্যাপ\",\"page\":\"পৃষ্ঠা\",\"pages\":\"পৃষ্ঠাসমূহ\",\"playStore\":\"|গুগল স্টোর| থেকে ডাউনলোড করুন\",\"quick_links\":\"Quick Links\",\"quran\":\"আল কুরআন\",\"quran_iframe_error\":\"Failed to load the Quran section. Try refreshing the page.\",\"quran_loading\":\"Loading the Holy Quran...\",\"quran_sounds\":\"Audio Quran\",\"reader1\":\"আবদুল বাসিত আবদুস সামাদ\",\"reader2\":\"মুহাম্মদ সিদ্দিক মিনশাভি\",\"reader3\":\"মাহমুদ খলিল হুসারি\",\"reader5\":\"মাহের মুয়াইকলি\",\"reader6\":\"সাদ আল গামেদি\",\"readers\":\"কারীগণ\",\"readLess\":\"কম পড়ুন\",\"readMore\":\"আরো পড়ুন\",\"redBookmarks\":\"লাল বুকমার্ক\",\"redirecting_store\":\"কিছুক্ষণের মধ্যে আপনাকে উপযুক্ত স্টোরে রিডাইরেক্ট করা হবে...\",\"required_field\":\"এই ক্ষেত্রটি প্রয়োজনীয়\",\"sajda\":\"সিজদা\",\"search\":\"অনুসন্ধান\",\"searchInBooks\":\"বইসমূহে অনুসন্ধান করুন\",\"select_player\":\"কারী নির্বাচন করুন\",\"send\":\"পাঠান\",\"sending\":\"পাঠানো হচ্ছে...\",\"service_azkar_desc\":\"Morning and evening adhkar and Hisnul Muslim, in a practical format that helps you persist.\",\"service_books_desc\":\"A valuable library of books, hadith, and tafsir, carefully curated for you.\",\"service_quran_desc\":\"Reading in Uthmani script with tafsir and translation for every verse.\",\"service_sound_desc\":\"Listen with a selection of renowned reciters, with repeat and bookmarking.\",\"services\":\"Services\",\"services_eyebrow\":\"Our Services\",\"services_head\":\"আমরা কী প্রদান করি?\",\"services_lede\":\"Four integrated services that guide you on a spiritual journey from reading to listening to remembrance.\",\"services_title\":\"সেবাসমূহ\",\"services_title_1\":\"Gates of\",\"services_title_2\":\"Wisdom\",\"sixthBooks\":\"ষষ্ঠ বইসমূহ\",\"stat_languages\":\"Languages\",\"stat_pages\":\"Quran pages\",\"stat_reciters\":\"Reciters\",\"stat_surahs\":\"Surahs\",\"surahNames\":\"সূরার নাম\",\"surahs\":\"সূরাসমূহ\",\"svc_apps\":\"অ্যাপ্লিকেশন তৈরি\",\"svc_apps_desc\":\"আমরা উচ্চ পারফরম্যান্স এবং আরামদায়ক ব্যবহারকারীর অভিজ্ঞতা সহ আধুনিক মোবাইল অ্যাপ্লিকেশন ডেভেলপ করি।\",\"svc_azkar\":\"আযকার\",\"svc_azkar_desc\":\"সুন্দর সংগঠন এবং মৃদু বিজ্ঞপ্তি সহ দৈনিক যিকির।\",\"svc_books\":\"বইসমূহ\",\"svc_books_desc\":\"উপকারী কেতাব এবং রেফারেন্সের সংগ্রহ।\",\"svc_multi\":\"একাধিক প্ল্যাটফর্ম সাপোর্ট\",\"svc_multi_desc\":\"আমরা একটি কোডবেস থেকে iOS, Android এবং ওয়েবকে লক্ষ্য করি প্রতিটি প্ল্যাটফর্মের জন্য অপ্টিমাইজেশন সহ।\",\"svc_pro\":\"কাজে পেশাদারিত্ব\",\"svc_pro_desc\":\"বাস্তবায়নে মান, সময়ের প্রতি অঙ্গীকার এবং শুরু থেকে প্রকাশ পর্যন্ত বিস্তারিত যত্ন।\",\"svc_quran\":\"মুসহাফের পাঠ্য\",\"svc_quran_desc\":\"উন্নত পড়া এবং ব্রাউজিং সহ অনুসন্ধান এবং দ্রুত নেভিগেশন।\",\"tafsir\":\"তাফসীর\",\"tafsirIsEmptyNote\":\"\\n\\nএই আয়াতের তাফসীর পূর্ববর্তী আয়াতগুলিতে রয়েছে\",\"translate\":\"অনুবাদসমূহ