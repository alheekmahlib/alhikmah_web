 API and open-source libraries.\"}]\n1d:I[75696,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/1kmzfrn9ymvcu.js\",\"/_next/static/chunks/3qssvey5t78f1.js\",\"/_next/static/chunks/25lxdbndxci5v.js\",\"/_next/static/chunks/1ijqylqiu6wig.js\"],\"default\"]\n1e:Tc7c,◉ এই অ্যাপ্লিকেশনটি আপনাকে কুরআন পড়তে সক্ষম করে যেন আপনি মুসহাফে পড়ছেন, এবং আপনি উল্লম্ব এবং অনুভূমিক মোডে পড়তে পারেন।\n◉ এছাড়াও আপনি পরিবর্তনীয় মোডে পড়তে পারেন যা আপনাকে ইচ্ছামতো জুম ইন এবং জুম আউট করতে সক্ষম করে।\n◉ অ্যাপ্লিকেশনে তাৎক্ষণিক অনুসন্ধান এবং পৃষ্ঠাগুলির সাথে ফলাফল প্রদর্শনের মাধ্যমে কুরআনের আয়াতগুলিতে পাঠ্য অনুসন্ধানের বৈশিষ্ট্য রয়েছে এবং প্রয়োজনে পৃষ্ঠায় যাওয়ার সম্ভাবনা রয়েছে।\n◉ পড়ার জন্য বুকমার্ক যোগ করা যাতে পাঠক পৃষ্ঠা সংরক্ষণ করতে এবং যখনই চান তাতে ফিরতে পারেন।\n◉ নোট যোগ করা।\n◉ বিভিন্ন কারীর কণ্ঠে প্রতিটি আয়াত শোনার ক্ষমতা।\n◉ অ্যাপ প্রতিটি আয়াতের জন্য তাফসীর সরবরাহ করে, আপনি তাফসীরের মধ্যে পরিবর্তন করতে পারেন এবং তাফসীরের ফন্টের আকার পরিবর্তন করতে পারেন।\n◉ সূরার সূচী।\n◉ সূরাগুলির মধ্যে সহজে নেভিগেট করা।\n◉ অ্যাপ আপনাকে বিরতি চিহ্নের অর্থ পড়তে দেয়।\n◉ অ্যাপ্লিকেশনটি আপনাকে হিসনুল মুসলিম সম্পূর্ণ পড়তে এবং যিকির অনুযায়ী বিভক্ত করতে সক্ষম করে যাতে পাঠকের পক্ষে বিভাগগুলির মধ্যে নেভিগেট করা সহজ হয় এবং আপনি যেকোনো যিকির পছন্দের তালিকায় যোগ করতে পারেন।\n◉ অ্যাপ্লিকেশনটি পাঠককে রঙের প্যাটার্ন পরিবর্তন করার অনুমতি দেয়, যার মধ্যে ডার্ক প্যাটার্ন রয়েছে যা পটভূমির রঙ কালো এবং সাদা লাইনে পরিবর্তন করে কম আলোর পরিবেশে পড়ার সময় পাঠককে সম্পূর্ণ আরাম দিতে।4:[\"$\",\"$L1d\",null,{\"formats\":\"$undefined\",\"locale\":\"be\",\"messages\":{\"about\":\"About\",\"about_app\":\"অ্যাপ সম্পর্কে\",\"about_app2\":\"প্রোগ্রামের সবচেয়ে গুরুত্বপূর্ণ বৈশিষ্ট্যগুলি:\",\"about_body\":\"আমরা একটি লাইব্রেরি যা ইসলামিক এবং শিক্ষামূলক চরিত্রের অ্যাপ্লিকেশন উন্নয়ন ও নির্মাণে বিশেষায়িত। আমাদের লক্ষ্য হল নির্ভরযোগ্য এবং ব্যবহার-বান্ধব ডিজিটাল সমাধান প্রদান করা যা মুসলমানদের সুন্দর এবং পরিমার্জিত প্রযুক্তিগত অভিজ্ঞতার মাধ্যমে পড়তে, শিখতে এবং আল্লাহর স্মরণে প্রতিশ্রুতিবদ্ধ থাকতে সাহায্য করে। আমরা উচ্চ কর্মক্ষমতা, অ্যাক্সেসিবিলিটি এবং বহু-প্ল্যাটফর্ম সমর্থনের উপর ফোকাস করি যাতে সর্বাধিক সংখ্যক ব্যবহারকারীর কাছে সুবিধা পৌঁছানো যায়।\",\"about_contact_cta\":\"আপনার সাথে কথা বলতে আমরা খুশি — নিচে আমাদের লিখুন:\",\"about_eyebrow\":\"About Us\",\"about_hadith_ref\":\"Narrated by Muslim\",\"about_hadith_text\":\"“Whoever follows a path seeking knowledge, Allah will make easy for him a path to Paradise”\",\"about_head\":\"আল হিকমাহ লাইব্রেরি\",\"about_p1\":\"Alheekmah Library is a comprehensive Islamic platform, born from a passion to serve the Book of Allah and the Sunnah of His Prophet ﷺ. We believe that beneficial knowledge is a trust that must reach every home through the easiest and most beautiful means.\",\"about_p2\":\"We combine the authenticity of content with the beauty of experience, to bring you the Quran with its recitations, Adhkar, and selected books — in one harmonious interface.\",\"about_page_eyebrow\":\"About Us\",\"about_page_lede\":\"A comprehensive Islamic platform for spreading beneficial knowledge.\",\"about_page_story_1\":\"Alheekmah Library was born from a passion to serve the Book of Allah and the Sunnah of His Prophet ﷺ. We believe beneficial knowledge is a trust that must reach every home through the easiest and most beautiful means.\",\"about_page_story_2\":\"We combine content authenticity with experience beauty, to bring you the Quran with its recitations, Adhkar, and selected books — in one harmonious interface.\",\"about_page_story_3\":\"We focus on high performance, accessibility, and multi-platform support to ensure the benefit reaches the maximum number of users.\",\"about_page_title\":\"Alheekmah Library\",\"about_stat_1\":\"Downloads\",\"about_stat_2\":\"Languages\",\"about_stat_3\":\"Apps\",\"about_stat_4\":\"Free\",\"about_title\":\"আমরা কারা\",\"about_title_1\":\"A message of\",\"about_title_2\":\"beneficial knowledge\",\"about_us\":\"অ্যাপ সম্পর্কে\",\"about_value_1_desc\":\"We care about the finest details to deliver a refined experience.\",\"about_value_1_title\":\"Quality\",\"about_value_2_desc\":\"Trusted content from approved sources and reliable scholars.\",\"about_value_2_title\":\"Authenticity\",\"about_value_3_desc\":\"We put user needs first in everything we design.\",\"about_value_3_title\":\"Service\",\"about_value_4_desc\":\"Open to developers via API and open-source libraries.\",\"about_value_4_title\":\"Openness\",\"about_values_title\":\"Our Values\",\"about_vision_text\":\"To be the leading Islamic platform, in Arabic and internationally, in spreading beneficial knowledge through refined user experience and trusted content.\",\"about_vision_title\":\"Our Vision\",\"aboutAzkaryApp3\":\"◉ এই অ্যাপ্লিকেশনটি আপনাকে আপনার পছন্দের যিকিরগুলি একটি বিশেষ তালিকায় সংরক্ষণ করার সুবিধা দেয়, যা তাদের যেকোনো সময় সহজে অ্যাক্সেসযোগ্য এবং পর্যালোচনাযোগ্য করে তোলে।\\n◉ আপনি ফন্টের আকার নিয়ন্ত্রণ করতে পারেন এবং আরও আরামদায়ক পড়ার জন্য আপনার পছন্দ অনুযায়ী এটি বড় বা ছোট করতে পারেন।\\n◉ অ্যাপ্লিকেশনটি ব্যবহারকারী ইন্টারফেসের জন্য তিনটি মোড সরবরাহ করে - সবুজ, নীল এবং অন্ধকার - যা আপনাকে আপনার পছন্দ অনুযায়ী অ্যাপের চেহারা কাস্টমাইজ করার ক্ষমতা দেয়।\\n◉ \\\"কিতাব ও সুন্নাহ থেকে আমার যিকির\\\" এর বিশেষত্ব হল বন্ধু এবং পরিবারের সাথে সহজে যিকির ভাগ করার ক্ষমতা।\\n◉ আপনি সরাসরি পাঠ্যে ভাগ করতে পারেন বা যিকির সম্বলিত ছবি পাঠিয়ে ভাগ করতে পারেন, যা অন্যদের সাথে যোগাযোগ এবং মিথস্ক্রিয়ার অভিজ্ঞতাকে আরও সমৃদ্ধ এবং গভীর করে তোলে।\\n◉ আপনি যিকির পড়ার জন্য আপনার পছন্দের সময় নির্ধারণ করতে পারেন, এবং অ্যাপ্লিকেশনটি সেই সময়গুলিতে আপনাকে সঠিকভাবে মনে করিয়ে দেবে।\",\"aboutBook\":\"বই সম্পর্কে\",\"aboutBooks\":\"বই সম্পর্কে\",\"aboutQuranApp3\":\"$1e\",\"aboutSurah\":\"সূরা সম্পর্কে\",\"action_browse\":\"Browse\",\"action_listen\":\"Listen\",\"action_read\":\"Read\",\"action_review\":\"Review\",\"allBooks\":\"সকল বই\",\"app_hisn_desc\":\"Adhkar and supplications from the Quran and Sunnah, in a practical daily format that helps you persist.\",\"app_hisn_title\":\"Hisnul Muslim\",\"app_not_found\":\"অনুরোধকৃত অ্যাপ খুঁজে পাওয়া যায়নি।\",\"app_qalaid_desc\":\"A digital library of selected Islamic books and beneficial knowledge, at your fingertips anytime.\",\"app_qalaid_title\":\"Al-Qalaid\",\"app_quran_desc\":\"A comprehensive app for reading the Holy Quran with recitations, tafsir, and translation for every verse.\",\"app_quran_title\":\"Holy Quran\",\"appGallery\":\"|অ্যাপ গ্যালারি| থেকে ডাউনলোড করুন\",\"appLang\":\"অ্যাপের ভাষা\",\"appName\":\"আল হিকমাহ লাইব্রেরি\",\"apps\":\"Our Apps\",\"apps_error\":\"Failed to load apps. Try again later.\",\"apps_eyebrow\":\"Our Apps\",\"apps_lede\":\"Apps carefully designed to accompany your daily life and be your companion on the path to Allah.\",\"apps_loading\":\"Loading apps...\",\"apps_page_eyebrow\":\"Our Apps\",\"apps_page_lede\":\"Islamic apps carefully designed to accompany your daily life.\",\"apps_page_title\":\"Apps Family\",\"apps_title_1\":\"From the\",\"apps_title_2\":\"Alheekmah\",\"apps_view_details\":\"View details\",\"appStoreD\":\"ডেস্কটপের জন্য |অ্যাপ স্টোর| থেকে ডাউনলোড করুন\",\"appStoreI\":\"|অ্যাপ স্টোর| থেকে ডাউনলোড করুন\",\"athkar\":\"আযকার\",\"athkar_copied\":\"Copied\",\"athkar_copy\":\"Copy\",\"athkar_count_label\":\"Repeat\",\"athkar_done\":\"Done, alhamdulillah\",\"athkar_empty\":\"No adhkar in this category.\",\"athkar_eyebrow\":\"Hisnul Muslim\",\"athkar_lede\":\"Morning and evening adhkar and supplications from Quran and Sunnah.\",\"athkar_of\":\"of\",\"athkar_reset\":\"Reset\",\"athkar_search_category\":\"Search category...\",\"athkar_tap_count\":\"Tap to count\",\"athkar_title\":\"Adhkar & Supplications\",\"aya_count\":\"আয়াত সংখ্যা\",\"ayah\":\"আয়াত\",\"ayah_band_ref\":\"Surah Al-Isra · Verse 82\",\"ayah_band_text\":\"And We send down of the Quran that which is a healing and a mercy for the believers\",\"ayah_copied\":\"আয়াত কপি হয়েছে\",\"ayahs\":\"আয়াতসমূহ\",\"azkar\":\"আযকার\",\"book_back\":\"Back\",\"book_back_to_li