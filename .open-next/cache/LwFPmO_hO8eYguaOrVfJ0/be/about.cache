t.\"}]]}]]}]}]}]\na:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/3p5tnn-thhdxt.js\",\"async\":true}]\nb:[\"$\",\"$L11\",null,{\"children\":[\"$\",\"$12\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@13\"}]}]\nd:[\"$\",\"p\",null,{\"className\":\"text-[0.82rem] leading-relaxed text-ink-soft\",\"children\":\"مكتبات وواجهات برمجية مفتوحة للمطورين\"}]\ne:[\"$\",\"$Lc\",null,{\"iconNode\":[[\"path\",{\"d\":\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\",\"key\":\"1yiouv\"}],[\"circle\",{\"cx\":\"12\",\"cy\":\"8\",\"r\":\"6\",\"key\":\"1vp47v\"}]],\"className\":\"lucide-award h-7 w-7\",\"strokeWidth\":1.6}]\nf:[\"$\",\"h3\",null,{\"className\":\"mb-2 font-display text-lg font-bold text-ink\",\"children\":\"Openness\"}]\n10:[\"$\",\"p\",null,{\"className\":\"text-[0.86rem] leading-relaxed text-ink-soft\",\"children\":\"Open to developers via API and open-source libraries.\"}]\n13:null\n","/$d$locale/about":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\"],\"default\"]\n4:[]\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L3\",null,{}]}]]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":\"$W4\",\"buildId\":\"LwFPmO_hO8eYguaOrVfJ0\"}\n","/$d$locale":"1:\"$Sreact.fragment\"\n2:I[75696,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/1kmzfrn9ymvcu.js\",\"/_next/static/chunks/3qssvey5t78f1.js\",\"/_next/static/chunks/25lxdbndxci5v.js\",\"/_next/static/chunks/1ijqylqiu6wig.js\"],\"default\"]\n5:I[82102,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\",\"/_next/static/chunks/1kmzfrn9ymvcu.js\",\"/_next/static/chunks/3qss