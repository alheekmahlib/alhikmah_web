{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alhikmah",
  // لا نُصلّب account_id هنا: بيئة Cloudflare Workers Builds تضبط
  // CLOUDFLARE_ACCOUNT_ID تلقائياً (حساب المالك)، وwrangler يعتمده عند النشر.
  // كتابة معرّف ثابت تُفشل النشر عند اختلاف الحساب (خطأ "account_id must match").
  "compatibility_date": "2026-07-22",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_QURAN_IFRAME_URL": "https://alhikmah-quran.haozo89.workers.dev",
    "NEXT_PUBLIC_SITE_URL": "https://alhikmah.ahmedlabtop4.workers.dev"
  },
  // كاش الصفحات الثابتة عبر R2: يمنع إعادة SSR عند كل طلب (سبب أخطاء 503 عند تبديل اللغة).
  // يجب إنشاء الـ bucket أولاً: npx wrangler r2 bucket create alhikmah-opennext-cache
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "alhikmah-opennext-cache"
    }
  ]
}
